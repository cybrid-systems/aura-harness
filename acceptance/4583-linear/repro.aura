;; cybrid-systems/aura#4583 (reopened, linear part): rebinding the same body must cost the same on rebind 1000 as on
;; rebind 1. Mean µs of rebinds 1001-1500 vs 1-500; PASS when the ratio stays below 1.5.
(set-code "(define f (lambda (x) (cond ((equal? x \"a\") 1) (else 0))))\n(define g (lambda (x) (f x)))")
(eval-current)
(define body-a "(lambda (x) (cond ((equal? x \"a\") 1) (else 0)))")
(define (block n)
  (let ((t0 (current-time-ms)))
    (let loop ((i 1)) (if (<= i n) (begin (mutate:rebind "f" body-a "m") (eval-current) (loop (+ i 1)))))
    (max 1 (- (current-time-ms) t0))))
(define first (block 500))
(block 500)
(define last (block 500))
(display (list "first-ms" first "last-ms" last)) (newline)
(display (list "flat" (< (/ last first) 1.5))) (newline)
