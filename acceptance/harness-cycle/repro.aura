;; aura-harness's own shape: a trial in a child workspace and a snapshot trial leave the root byte-identical;
;; a guarded keep changes exactly one define.
(set-code "(define compress (lambda (kind) (list \"head\" 800)))\n(define context-budget (lambda () 4000))") (eval-current)
(define src0 (current-source :workspace))
(define w (workspace :create "trial"))
(workspace :switch w)
(mutate:rebind "compress" "(lambda (kind) (list \"tail\" 800))" "trial") (eval-current)
(define in-child (compress "test-log"))
(workspace :switch 0) (eval-current) (workspace :delete w)
(define s (ast:snapshot "pre"))
(mutate:rebind "compress" "(lambda (kind) (list \"summarize\" 800))" "trial2") (eval-current)
(define in-snap (compress "test-log"))
(ast:restore s) (eval-current)
(define same (equal? (current-source :workspace) src0))
(mutate:rebind "compress" "(lambda (kind) (list \"tail\" 800))" "keep") (eval-current)
(display (if (and same (equal? in-child (list "tail" 800)) (equal? in-snap (list "summarize" 800))
                  (equal? (compress "x") (list "tail" 800)) (= (context-budget) 4000))
             "OK" (list "BAD" same in-child in-snap (compress "x"))))
(newline)
