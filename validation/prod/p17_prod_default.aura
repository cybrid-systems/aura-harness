;; p17_prod_default -- @@prod-default: runs with AURA_SANDBOX and AURA_PIPELINE_STRICT unset (the face a user gets by default)
;; aura#4870: agent / scope bodies must really run and agent-ask must answer without AURA_SANDBOX=off.
;; Restricted denies Mutate to a tenant-0 CLI program by design (aura#4575; `aura soft` grants it),
;; and concurrent spawns need :region-key (aura#4280 / #4238); both are checked as documented behaviour.
(define p17-out (channel:create 16))
(define c17 0)
(orch:spawn-agent "p17-a" (lambda () (channel:send p17-out 'body-ran) (set! c17 1) 42))
(define j17 (orch:agent-join "p17-a" :timeout-ms 3000))
(check! "proddef.agent-body-runs" (and (eq? #t (hg j17 "ok" #f)) (equal? 'body-ran (channel:try-recv p17-out)) (= c17 1)) (format "join ~a c ~a" (hg j17 "status" '?) c17))
(orch:scope-spawn "p17-k" (lambda () (channel:send p17-out 'scope-ran) 7))
(define s17 (orch:scope-join-all :timeout-ms 3000))
(check! "proddef.scope-body-runs" (and (equal? "ok" (str (hg s17 "status" '?))) (equal? 'scope-ran (channel:try-recv p17-out))) (format "scope ~a" (hg s17 "status" '?)))
(orch:spawn-agent "p17-n" (lambda ()
  (orch:scope-spawn "p17-n1" (lambda () (channel:send p17-out 'nested-ran) 1))
  (let ((r (orch:scope-join-all :timeout-ms 2000))) (channel:send p17-out (str (hg r "status" '?)))) 'outer))
(define jn17 (orch:agent-join "p17-n" :timeout-ms 4000))
(define n17 (list (channel:try-recv p17-out) (channel:try-recv p17-out)))
(check! "proddef.nested-scope-in-agent" (and (eq? #t (hg jn17 "ok" #f)) (equal? n17 (list 'nested-ran "ok"))) (format "join ~a got ~a" (hg jn17 "status" '?) n17))
(orch:spawn-agent "p17-w" (lambda ()
  (let loop ((n 0))
    (if (< n 3)
        (let ((m (orch:agent-recv "p17-w" :wait #t :timeout-ms 3000)))
          (if (eq? #t (hg m "ok" #f)) (begin (orch:agent-reply (hg m "correlation-id" 0) n) (loop (+ n 1))) 'timeout))
        'served))) :attach-mailbox #t)
(define a17 (map (lambda (i) (orch:agent-ask "p17-w" (number->string i) :timeout-ms 2000)) (range 3)))
(check! "proddef.agent-ask" (= 3 (count-if (lambda (a) (eq? #t (hg a "ok" #f))) a17)) (format "ok ~a/3" (count-if (lambda (a) (eq? #t (hg a "ok" #f))) a17)))
(orch:agent-join "p17-w" :timeout-ms 3000)
;; concurrent spawns without :region-key are denied with ok #f (not silently dropped); with distinct keys both run
(define d1 (orch:spawn-agent "p17-r1" (lambda () (fiber:yield) (channel:send p17-out 'r1) 1)))
(define d2 (orch:spawn-agent "p17-r2" (lambda () (channel:send p17-out 'r2) 2)))
(check! "proddef.concurrent-spawn-no-region-key-denied-loudly" (and (eq? #t (hg d1 "ok" #f)) (eq? #f (hg d2 "ok" #t)) (string? (hg d2 "error" #f))) (format "second spawn ~a" (hg d2 "ok" '?)))
(orch:agent-join "p17-r1" :timeout-ms 2000) (channel:try-recv p17-out)
(orch:spawn-agent "p17-k1" (lambda () (channel:send p17-out 'k1) 1) :region-key 1)
(orch:spawn-agent "p17-k2" (lambda () (channel:send p17-out 'k2) 2) :region-key 2)
(orch:agent-join "p17-k1" :timeout-ms 2000) (orch:agent-join "p17-k2" :timeout-ms 2000)
(define rk17 (list (channel:try-recv p17-out) (channel:try-recv p17-out)))
(check! "proddef.concurrent-spawn-region-keys" (and (member 'k1 rk17) (member 'k2 rk17) #t) (format "got ~a" rk17))
;; two blocking-recv mailbox workers with distinct region keys must both answer
(define (blk17 name rk) (orch:spawn-agent name (lambda ()
  (let ((m (orch:agent-recv name :wait #t :timeout-ms 2500)))
    (when (eq? #t (hg m "ok" #f)) (orch:agent-reply (hg m "correlation-id" 0) 1)) 'done)) :attach-mailbox #t :region-key rk))
(blk17 "p17-b1" 1) (blk17 "p17-b2" 2)
(define b17 (list (hg (orch:agent-ask "p17-b2" "x" :timeout-ms 1500) "ok" '?) (hg (orch:agent-ask "p17-b1" "y" :timeout-ms 1500) "ok" '?)))
(check! "proddef.two-blocking-workers-answer" (equal? b17 (list #t #t)) (format "asks ~a" b17))
(orch:agent-join "p17-b1" :timeout-ms 3000) (orch:agent-join "p17-b2" :timeout-ms 3000)
;; a worker blocked in agent-recv :wait #t must not keep a second agent from even starting
(define t17 (monotonic-ms))
(orch:spawn-agent "p17-s1" (lambda () (orch:agent-recv "p17-s1" :wait #t :timeout-ms 2000) 'done) :attach-mailbox #t :region-key 3)
(orch:spawn-agent "p17-s2" (lambda () (channel:send p17-out (- (monotonic-ms) t17)) 'done) :region-key 4)
(orch:agent-join "p17-s2" :timeout-ms 4000) (orch:agent-join "p17-s1" :timeout-ms 4000)
(define st17 (channel:try-recv p17-out))
(check! "proddef.blocked-recv-does-not-starve-spawn" (and (number? st17) (< st17 500)) (format "second agent started after ~a ms" st17))
;; Restricted: every data mutator is gated alike (no Mutate grant for a CLI program)
;; string-index returns -1 (truthy) on a miss, so match with string-contains?
(define (denied? th) (try (begin (th) #f) (catch (e) (string-contains? (str e) "effect-denied"))))
(define v17 (vector 1 2))
(check! "proddef.vector-set-denied" (eq? #t (denied? (lambda () (vector-set! v17 0 9)))) "vector-set! allowed")
(check! "proddef.vector-fill-denied" (eq? #t (denied? (lambda () (vector-fill! v17 9)))) (format "vector-fill! allowed, v=~a" v17))
(check! "proddef.hash-set-denied" (eq? #t (denied? (lambda () (hash-set! (hash) "a" 1)))) "hash-set! allowed")
;; user macros need MacroSelfEvo, which Restricted denies by design; the deny must name it (#4876)
(define (macro-ok? r) (or (equal? r 3) (and (string? r) (string-contains? r "macro-self-evo"))))
(define m17 (try (eval '(begin (define-hygienic-macro (or2-h a b) (let ((t a)) (if t t b))) (or2-h #f 3))) (catch (e) (format "~a" e))))
(check! "proddef.user-macro-expands" (macro-ok? m17) (format "got ~a" m17))
(define dm17 (try (eval '(begin (defmacro (m1-17 x) (list (quote +) x 2)) (m1-17 1))) (catch (e) (format "~a" e))))
(check! "proddef.user-defmacro-diagnostic" (macro-ok? dm17) (format "got ~a" dm17))
(emit "done" "ok")
