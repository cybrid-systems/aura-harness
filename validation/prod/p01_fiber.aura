;; p01_fiber -- fiber lifecycle under production load: leaks, cancellation races, error propagation.
(define keep (lambda () 1))
(define (seq n) (let loop ((i 0)) (when (< i n) (fiber:join (fiber:spawn keep)) (loop (+ i 1)))))
;; warm-up, then 20k sequential spawn+join must not grow RSS linearly (aura#4821: ~640 B/fiber)
(seq 2000)
(define r0 (rss-kb))
(seq 20000)
(define dr (- (rss-kb) r0))
(bench! "fiber.seq20k.rss-delta" dr "kB")
(check! "fiber.seq20k.no-leak" (< dr 4096) (format "RSS +~a kB over 20k spawn/join" dr))
;; cancellation race: 64 spinning fibers, cancel all, every join must return (no hang) and
;; every body must have observed the cancel at its yield safepoint.
(define (spinner) (let loop ((i 0)) (fiber:yield) (loop (+ i 1))))
(define fs (map (lambda (i) (fiber:spawn spinner)) (range 64)))
(define accepted (count-if (lambda (f) (eq? #t (fiber:cancel f))) fs))
(define t0 (monotonic-ms))
(define joined (map (lambda (f) (safe (lambda () (fiber:join f)) 'raised)) fs))
(bench! "fiber.cancel64.join-ms" (- (monotonic-ms) t0) "ms")
(check! "fiber.cancel64.accepted" (= accepted 64) (format "~a/64 cancel requests accepted" accepted))
(check! "fiber.cancel64.all-joined" (= (length joined) 64) "join returned for every cancelled fiber")
(check! "fiber.cancel64.cancel-visible"
        (all? (lambda (v) (or (eq? v 'raised) (string-contains? (str v) "cancel"))) joined)
        (format "join results: ~a" (list-head-safe joined 3)))
;; a cancel of an already-finished fiber is #f, not an error
(define done-f (fiber:spawn keep))
(fiber:join done-f)
(check! "fiber.cancel-finished-is-f" (eq? #f (safe (lambda () (fiber:cancel done-f)) 'err)) "cancel after join")
;; error propagation through fiber:join (aura#4823)
(define (join-err th) (try (begin (fiber:join (fiber:spawn th)) 'no-error) (catch (e) e)))
(define e1 (join-err (lambda () (raise 'my-sym))))
(check! "fiber.join.raise-symbol-preserved" (symbol? e1) (format "got ~a" e1))
(define e2 (join-err (lambda () (raise (hash "code" 7)))))
(check! "fiber.join.raise-hash-preserved" (and (hash? e2) (equal? (hash-ref e2 "code") 7)) (format "got ~a" e2))
(define e3 (join-err (lambda () (error "boom"))))
(check! "fiber.join.error-not-relabelled" (not (string-contains? (str e3) "type error")) (format "got ~a" e3))
(emit "done" "ok")
