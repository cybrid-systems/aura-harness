;; p11_orch_failure -- failure propagation and retries: nested chains, cancel policy, restart-n, error payload kinds.
(define (spin-ms ms) (let ((t (+ (monotonic-ms) ms))) (let loop () (when (< (monotonic-ms) t) (fiber:yield) (loop)))))
(define (show h) (if (hash? h) (map (lambda (k) (cons k (hash-ref h k))) (sorted-strs (map str (hash-keys h)))) h))
;; 1) error payload kinds as seen in agent-join "error"
(define kinds (list (cons "err" (lambda () (error "plain message")))
                    (cons "sym" (lambda () (raise 'my-symbol)))
                    (cons "hash" (lambda () (raise (hash "code" 42))))
                    (cons "car" (lambda () (car 5)))
                    (cons "div" (lambda () (/ 1 0)))
                    (cons "unbound" (lambda () (no-such-fn 1)))
                    (cons "fiberjoin" (lambda () (fiber:join (fiber:spawn (lambda () (error "inner fiber")))))) ))
(for-each (lambda (p) (orch:spawn-agent (string-append "p11-k-" (car p)) (cdr p))) kinds)
(define kj (map (lambda (p) (cons (car p) (orch:agent-join (string-append "p11-k-" (car p)) :timeout-ms 3000))) kinds))
(for-each (lambda (p) (info! (string-append "orchfail.kind." (car p)) (format "ok=~a status=~a error=~s" (hg (cdr p) "ok" 'x) (hg (cdr p) "status" 'x) (hg (cdr p) "error" 'none)))) kj)
(check! "orchfail.kinds.all-not-ok" (all? (lambda (p) (eq? #f (hg (cdr p) "ok" 'x))) kj) (format "~a" (map (lambda (p) (list (car p) (hg (cdr p) "status" 'x))) kj)))
(check! "orchfail.kinds.status-error" (all? (lambda (p) (equal? (str (hg (cdr p) "status" "")) "error")) kj) (format "~a" (map (lambda (p) (list (car p) (hg (cdr p) "status" 'x))) kj)))
(check! "orchfail.kinds.message-kept"
  (and (string-contains? (str (hg (cdr (assoc "err" kj)) "error" "")) "plain message")
       (string-contains? (str (hg (cdr (assoc "sym" kj)) "error" "")) "my-symbol")
       (string-contains? (str (hg (cdr (assoc "fiberjoin" kj)) "error" "")) "inner fiber")
       (string-contains? (str (hg (cdr (assoc "unbound" kj)) "error" "")) "no-such-fn"))
  (format "~s" (map (lambda (p) (cons (car p) (hg (cdr p) "error" 'none))) kj)))
;; 2) 3-level chain agent -> agent -> scope child: leaf error reaches top-level join
(orch:spawn-agent "p11-top" (lambda ()
  (orch:spawn-agent "p11-mid" (lambda ()
     (orch:scope-spawn "p11-leaf" (lambda () (error "leaf exploded")))
     (let ((r (orch:scope-join-all :timeout-ms 2000)))
       (if (eq? #t (hg r "ok" #f)) 'fine (error (format "mid saw: ~a" (hg r "errors" '())))))))
  (let ((m (orch:agent-join "p11-mid" :timeout-ms 3000)))
    (if (eq? #t (hg m "ok" #f)) 'fine (error (format "top saw: ~a" (hg m "error" 'none)))))))
(define tj (orch:agent-join "p11-top" :timeout-ms 6000))
(info! "orchfail.chain3" (format "status=~a error=~s" (hg tj "status" 'x) (hg tj "error" 'none)))
(check! "orchfail.chain3.leaf-msg-at-top" (string-contains? (str (hg tj "error" "")) "leaf exploded") (format "status=~a error=~s" (hg tj "status" 'x) (hg tj "error" 'none)))
;; 3) :on-join-fail "cancel": a failing sibling cancels the slow ones; join returns promptly
(orch:scope-spawn "p11-c-bad" (lambda () (spin-ms 20) (error "bad sibling")))
(for-each (lambda (i) (orch:scope-spawn (format "p11-c-slow~a" i) (lambda () (spin-ms 4000) 'late))) (range 4))
(define t3 (monotonic-ms))
(define cj (orch:scope-join-all :timeout-ms 6000 :on-join-fail "cancel"))
(define w3 (- (monotonic-ms) t3))
(info! "orchfail.cancel-policy" (format "after ~a ms: status=~a err=~a ok=~a cancelled=~a action=~a eff=~a" w3 (hg cj "status" 'x) (hg cj "err-count" 'x) (hg cj "body-ok-count" 'x) (hg cj "cancelled-count" 'x) (hg cj "join-fail-action-taken" 'x) (hg cj "on-join-fail-effective" 'x)))
(check! "orchfail.cancel-policy.prompt" (< w3 3000) (format "~a ms" w3))
(check! "orchfail.cancel-policy.siblings-cancelled" (= 4 (hg cj "cancelled-count" -1)) (format "cancelled-count=~a" (hg cj "cancelled-count" 'x)))
(safe (lambda () (orch:scope-cancel-all)) #f)
(safe (lambda () (orch:scope-join-all :timeout-ms 5000)) #f)
;; 4) :on-join-fail "restart": body fails twice then succeeds; does join re-run it?
(define attempts (hash))
(hash-set! attempts "n" 0)
(orch:scope-spawn "p11-flaky" (lambda () (hash-set! attempts "n" (+ 1 (hash-ref attempts "n"))) (if (< (hash-ref attempts "n") 3) (error (format "flaky attempt ~a" (hash-ref attempts "n"))) 'finally)))
(define rj (orch:scope-join-all :timeout-ms 5000 :on-join-fail "restart"))
(info! "orchfail.restart" (format "attempts=~a status=~a ok=~a err=~a restart-attempted=~a restart-ok=~a skipped-no-spec=~a eff=~a" (hash-ref attempts "n") (hg rj "status" 'x) (hg rj "ok" 'x) (hg rj "err-count" 'x) (hg rj "restart-attempted" 'x) (hg rj "restart-ok" 'x) (hg rj "restart-skipped-no-spec" 'x) (hg rj "on-join-fail-effective" 'x)))
(check! "orchfail.restart.policy-honoured" (equal? (str (hg rj "on-join-fail-effective" "")) "restart-n") (format "eff=~a" (hg rj "on-join-fail-effective" 'x)))
(check! "orchfail.restart.reran-or-says-why" (or (> (hash-ref attempts "n") 1) (> (hg rj "restart-skipped-no-spec" 0) 0)) (format "attempts=~a attempted=~a skipped=~a" (hash-ref attempts "n") (hg rj "restart-attempted" 'x) (hg rj "restart-skipped-no-spec" 'x)))
;; 5) unknown :on-join-fail value: silently report-only? record
(orch:scope-spawn "p11-typo" (lambda () (error "x")))
(define yj (orch:scope-join-all :timeout-ms 2000 :on-join-fail "cancle"))
(info! "orchfail.policy-typo" (format "eff=~a status=~a" (hg yj "on-join-fail-effective" 'x) (hg yj "status" 'x)))
(check! "orchfail.policy-typo.rejected" (not (equal? (str (hg yj "on-join-fail-effective" "")) "report-only")) (format "typo 'cancle' silently became ~a" (hg yj "on-join-fail-effective" 'x)))
;; 6) app-level retry loop: an agent retries a flaky scope child 5x; total time bounded
(define t6 (monotonic-ms))
(orch:spawn-agent "p11-retrier" (lambda ()
  (let loop ((i 0))
    (orch:scope-spawn (format "p11-try~a" i) (lambda () (if (< i 4) (error (format "try ~a" i)) i)))
    (let ((r (orch:scope-join-all :timeout-ms 1000)))
      (cond ((eq? #t (hg r "ok" #f)) i) ((< i 6) (loop (+ i 1))) (else (error "gave up")))))))
(define rr (orch:agent-join "p11-retrier" :timeout-ms 8000))
(bench! "orchfail.retry5.ms" (- (monotonic-ms) t6) "ms")
(check! "orchfail.retry-loop.ok" (eq? #t (hg rr "ok" #f)) (format "status=~a error=~a" (hg rr "status" 'x) (hg rr "error" 'x)))
(emit "done" "ok")
