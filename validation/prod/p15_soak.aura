;; p15_soak -- long mixed workload (fibers, agents, scopes, COW, channels, gc) for SOAK_SEC seconds (default 60 in the suite; set SOAK_SEC=600 for the 10-minute soak).
;; Samples RSS each round; checks no failure, no crash, and RSS growth over the second half stays bounded.
(define (spin-ms ms) (let ((t (+ (monotonic-ms) ms))) (let loop () (when (< (monotonic-ms) t) (fiber:yield) (loop)))))
(define secs (let ((s (safe (lambda () (getenv "SOAK_SEC")) #f))) (if (and (string? s) (> (string-length s) 0)) (string->number s) 60)))
(define deadline (+ (monotonic-ms) (* 1000 secs)))
(fiber:overlay-begin) (fiber:overlay-define "p15-c" 0) (fiber:overlay-commit)
(define ac 0)
(define fails (list))
(define (fail! what) (set! fails (cons what fails)))
(define (round! r)
  ;; fibers with errors
  (let ((fs (map (lambda (i) (fiber:spawn (lambda () (if (= 0 (modulo i 7)) (raise 'x) i)))) (range 100))))
    (let ((s (foldl + 0 (map (lambda (f) (try (fiber:join f) (catch (e) 0))) fs))))
      (unless (= s (- 4950 (foldl + 0 (filter (lambda (i) (= 0 (modulo i 7))) (range 100))))) (fail! (list r 'fiber-sum s)))))
  ;; agents + scopes
  (for-each (lambda (i) (set! ac (+ ac 1)) (orch:spawn-agent (format "p15-a~a" ac) (lambda () (spin-ms 2) (if (= i 3) (error "planned") i)))) (range 8))
  (let ((ok (count-if (lambda (k) (eq? #t (hg (orch:agent-join (format "p15-a~a" (- ac k)) :timeout-ms 5000) "ok" #f))) (range 8))))
    (unless (= ok 7) (fail! (list r 'agents-ok ok))))
  (for-each (lambda (k) (set! ac (+ ac 1)) (orch:scope-spawn (format "p15-s~a" ac) (lambda () (if (= k 0) (error "s") k)))) (range 6))
  (let ((sj (orch:scope-join-all :timeout-ms 5000)))
    (unless (and (= 1 (hg sj "err-count" -1)) (= 5 (hg sj "body-ok-count" -1))) (fail! (list r 'scope (hg sj "err-count" 'x) (hg sj "body-ok-count" 'x)))))
  ;; COW counter from 4 fibers
  (let ((ws (map (lambda (i) (fiber:spawn (lambda () (let retry ((n 0)) (fiber:overlay-begin) (fiber:overlay-set! "p15-c" (+ 1 (fiber:overlay-get "p15-c" 0)))
                   (let ((c (try (fiber:overlay-commit) (catch (e) #f)))) (if (and c (not (error? c))) 'ok (begin (safe (lambda () (fiber:overlay-rollback)) #f) (if (< n 100) (retry (+ n 1)) 'gave-up)))))))) (range 4))))
    (for-each (lambda (w) (safe (lambda () (fiber:join w)) #f)) ws))
  ;; channel ping-pong
  (let* ((c (channel:create 16)) (p (fiber:spawn (lambda () (for-each (lambda (i) (channel:send c i)) (range 200)) 'd))))
    (let ((s (foldl + 0 (map (lambda (i) (channel:recv c)) (range 200))))) (fiber:join p) (unless (= s 19900) (fail! (list r 'chan s)))))
  (when (= 0 (modulo r 5)) (safe (lambda () (gc-heap)) #f)))
(define t0 (monotonic-ms))
(define rounds 0)
(define samples (let loop ((r 0) (acc (list)))
  (if (> (monotonic-ms) deadline) (reverse acc)
      (begin (round! r) (set! rounds (+ r 1)) (loop (+ r 1) (if (= 0 (modulo r 10)) (cons (list r (- (monotonic-ms) t0) (rss-kb)) acc) acc))))))
(info! "soak.samples" samples)
(bench! "soak.rounds" rounds "rounds")
(bench! "soak.secs" (quotient (- (monotonic-ms) t0) 1000) "s")
(define c-final (fiber:overlay-get "p15-c" -1))
(check! "soak.cow-counter" (equal? c-final (* 4 rounds)) (format "~a (expected ~a)" c-final (* 4 rounds)))
(info! "soak.cow-counter" (format "~a (expected ~a)" c-final (* 4 rounds)))
(check! "soak.no-failures" (null? fails) (format "~a failures, first ~a" (length fails) (list-head-safe (reverse fails) 3)))
(define n (length samples))
(define mid (caddr (list-ref samples (quotient n 2))))
(define last (caddr (list-ref samples (- n 1))))
(bench! "soak.rss-second-half-growth" (- last mid) "kB")
(check! "soak.rss-bounded" (< (- last mid) 51200) (format "rss mid=~a last=~a" mid last))
(emit "done" "ok")
