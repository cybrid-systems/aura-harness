;; p02_orch -- agents and scopes: error propagation, ask throughput, join report hygiene.
(define (j name) (orch:agent-join name :timeout-ms 3000))
(orch:spawn-agent "p02-bad" (lambda () (error "agent crashed")))
(define jb (j "p02-bad"))
(check! "orch.agent-join.error-not-ok" (eq? #f (hg jb "ok" 'missing)) (format "ok=~a status=~a" (hg jb "ok" 'missing) (hg jb "status" 'missing)))
(check! "orch.agent-join.error-message" (string-contains? (str (hg jb "error" "")) "agent crashed") (format "error=~a" (hg jb "error" 'missing)))
(orch:spawn-agent "p02-good" (lambda () 42))
(define jg (j "p02-good"))
(check! "orch.agent-join.ok-body" (eq? #t (hg jg "ok" #f)) (format "status=~a" (hg jg "status" 'missing)))
(info! "orch.agent-join.report-keys" (length (hash-keys jg)))
(info! "orch.agent-join.issue-marker-keys"
       (count-if (lambda (k) (or (string-contains? k "issue-") (string-contains? k "schema"))) (hash-keys jg)))
;; scope join counts every failing child
(orch:scope-spawn "p02-s1" (lambda () (error "scope crashed")))
(orch:scope-spawn "p02-s2" (lambda () (car 1)))
(orch:scope-spawn "p02-s3" (lambda () (raise 'x)))
(orch:scope-spawn "p02-s4" (lambda () 1))
(define sj (orch:scope-join-all :timeout-ms 3000))
(check! "orch.scope-join.err-count" (equal? (hg sj "err-count" -1) 3) (format "err-count=~a ok=~a" (hg sj "err-count" -1) (hg sj "ok" 'missing)))
(check! "orch.scope-join.not-ok" (eq? #f (hg sj "ok" 'missing)) (format "ok=~a" (hg sj "ok" 'missing)))
;; ask round-trips: 300 sequential asks, all answered, latency recorded. The worker reads the
;; typed kind/correlation-id from agent-recv and answers with agent-reply. NOTE: the recv payload
;; still carries the legacy "ask:<id>:" text prefix and a non-string ask payload arrives as text.
(define (ask-body s) ; strip "ask:<id>:"
  (let ((i (string-index s ":")))
    (if (< i 0) s (let* ((rest (substring s (+ i 1) (string-length s))) (j (string-index rest ":")))
                    (if (< j 0) rest (substring rest (+ j 1) (string-length rest)))))))
;; aura#4831: this loop intermittently crashes (double free / SIGSEGV) or hangs on 02f65c038.
;; aura#4825: in an agent body agent-recv ignores :wait/:timeout-ms (returns empty at once), so the
;; worker polls (non-blocking recv + fiber:yield) and gives up after ~20k idle polls.
(orch:spawn-agent "p02-echo" (lambda ()
  (let loop ((n 0) (idle 0))
    (let ((m (orch:agent-recv "p02-echo" :wait #f)))
      (cond ((eq? #t (hg m "ok" #f))
             (if (equal? (str (hg m "kind" "")) "ask")
                 (begin (orch:agent-reply (hg m "correlation-id" 0) (ask-body (str (hg m "payload" ""))))
                        (loop (+ n 1) 0))
                 n))
            ((> idle 20000) n)
            (else (fiber:yield) (loop n (+ idle 1))))))) :attach-mailbox #t)
(define ask-raw (orch:agent-ask "p02-echo" "first" :timeout-ms 2000))
(info! "orch.ask.payload-roundtrip" (format "sent \"first\" got ~s status=~a" (hg ask-raw "payload" 'missing) (hg ask-raw "status" 'missing)))
(define (ask-ok? i) (let ((r (safe (lambda () (orch:agent-ask "p02-echo" (str i) :timeout-ms 500)) #f)))
                      (and (hash? r) (eq? #t (hg r "ok" #f)) (equal? (str (hg r "payload" "")) (str i)))))
(define t0 (monotonic-ms))
(define answered (count-if ask-ok? (range 300)))
(define ms (- (monotonic-ms) t0))
(bench! "orch.ask300.ms" ms "ms")
(bench! "orch.ask.us-per-roundtrip" (r3 (/ (* 1000.0 ms) 300)) "us")
(check! "orch.ask300.all-answered" (= answered 300) (format "~a/300 answered" answered))
(safe (lambda () (orch:agent-send "p02-echo" "stop")) #f)
(define je (j "p02-echo"))
(check! "orch.echo.join-ok" (eq? #t (hg je "ok" #f)) (format "status=~a" (hg je "status" 'missing)))
;; blocking recv inside an agent body honours :timeout-ms (aura#4825)
(define tw0 (monotonic-ms))
(orch:spawn-agent "p02-waiter" (lambda () (orch:agent-recv "p02-waiter" :wait #t :timeout-ms 400)) :attach-mailbox #t)
(define jw (j "p02-waiter"))
(define waited-ms (- (monotonic-ms) tw0))
(check! "orch.recv-wait-honoured" (>= waited-ms 350) (format "empty recv :timeout-ms 400 returned after ~a ms" waited-ms))
;; a mistyped worker (agent-recv without a name) must not turn every ask into a silent timeout
(define bad-recv (safe (lambda () (orch:agent-recv)) 'raised))
(check! "orch.recv-bad-arity-is-error" (or (eq? bad-recv 'raised) (error? bad-recv))
        (format "agent-recv with no args returned ~a" (if (hash? bad-recv) (map (lambda (k) (cons k (hash-ref bad-recv k))) (hash-keys bad-recv)) bad-recv)))
(emit "done" "ok")
