;; p18_fiber_rejoin -- joining an already-joined fiber again must keep answering (aura#4854 fix bounds the cache)
;; The second join runs in a reporting fiber so a hang shows up as a timeout instead of stalling the file.
(define f18 (fiber:spawn (lambda () 42)))
(check! "fiber.rejoin.immediate" (equal? 42 (fiber:join f18)) "first join")
(define (joins n) (let loop ((i 0)) (when (< i n) (fiber:join (fiber:spawn (lambda () i))) (loop (+ i 1)))))
(joins 500)
(define ch18 (channel:create 4))
(spawn-reporting ch18 "rj500" (lambda () (fiber:join f18)))
(define r500 (recv-within ch18 2000))
(check! "fiber.rejoin.after-500" (equal? r500 42) (format "got ~a" r500))
(joins 1100)
(spawn-reporting ch18 "rj1600" (lambda () (fiber:join f18)))
(define r1600 (recv-within ch18 2000))
(check! "fiber.rejoin.after-1600" (or (equal? r1600 42) (void? r1600)) (format "got ~a (void is the documented trade-off, a hang is not)" r1600))
(define g18 (fiber:spawn (lambda () 7)))
(joins 1500)
(check! "fiber.first-join-after-1500" (equal? 7 (fiber:join g18)) "late first join")
(emit "done" "ok")
