;; p05_fiber_stress -- fiber errors/cancellation under load, nested spawn, blocked-recv cancel.
;; 1) 500 fibers, every 3rd raises a symbol, every 5th calls (error ...), rest return i.
(define N 500)
(define (body i) (lambda ()
  (cond ((= 0 (modulo i 3)) (raise (string->symbol (format "e~a" i))))
        ((= 0 (modulo i 5)) (error (format "boom~a" i)))
        (else (* i 2)))))
(define t0 (monotonic-ms))
(define fs (map (lambda (i) (fiber:spawn (body i))) (range N)))
(define rs (map (lambda (f) (try (list 'ok (fiber:join f)) (catch (e) (list 'err e)))) fs))
(bench! "fiber.mixed500.ms" (- (monotonic-ms) t0) "ms")
(define (expect i r)
  (cond ((= 0 (modulo i 3)) (and (eq? (car r) 'err) (equal? (cadr r) (string->symbol (format "e~a" i)))))
        ((= 0 (modulo i 5)) (and (eq? (car r) 'err) (string-contains? (str (cadr r)) (format "boom~a" i))))
        (else (equal? r (list 'ok (* i 2))))))
(define bad (let loop ((i 0) (xs rs) (acc (list))) (if (null? xs) (reverse acc) (loop (+ i 1) (cdr xs) (if (expect i (car xs)) acc (cons (list i (car xs)) acc))))))
(check! "fiber.mixed500.payloads" (null? bad) (format "~a wrong, first ~a" (length bad) (list-head-safe bad 3)))
;; 3) nested: fiber spawns fiber spawns fiber that raises; error bubbles up 3 levels intact
(define nested (try (fiber:join (fiber:spawn (lambda ()
                  (fiber:join (fiber:spawn (lambda ()
                    (fiber:join (fiber:spawn (lambda () (raise (hash "lvl" 3)))))))))))
                (catch (e) e)))
(check! "fiber.nested3.raise-hash" (and (hash? nested) (equal? (hash-ref nested "lvl") 3)) (format "got ~a" nested))
;; 5) error inside a catch handler inside a fiber: the second error propagates
(define e5 (try (fiber:join (fiber:spawn (lambda () (try (raise 'first) (catch (e) (raise 'second)))))) (catch (e) e)))
(check! "fiber.rethrow-in-handler" (eq? e5 'second) (format "got ~a" e5))
;; 6) cancel a fiber twice and join; cancel returns #t then #f (or #t idempotent), never raises
(define fc (fiber:spawn (lambda () (let loop () (fiber:yield) (loop)))))
(define c1 (safe (lambda () (fiber:cancel fc)) 'raised))
(define c2 (safe (lambda () (fiber:cancel fc)) 'raised))
(safe (lambda () (fiber:join fc)) 'raised)
(check! "fiber.cancel-twice.no-raise" (and (boolean? c1) (boolean? c2)) (format "~a ~a" c1 c2))
;; 7) 2000 concurrent fibers alive at once (each yields 10x) -- throughput and completion
(define t7 (monotonic-ms))
(define f7 (map (lambda (i) (fiber:spawn (lambda () (let loop ((k 0)) (if (< k 10) (begin (fiber:yield) (loop (+ k 1))) i))))) (range 2000)))
(define s7 (foldl + 0 (map (lambda (f) (safe (lambda () (fiber:join f)) 0)) f7)))
(bench! "fiber.concurrent2000.ms" (- (monotonic-ms) t7) "ms")
(check! "fiber.concurrent2000.sum" (= s7 (/ (* 1999 2000) 2)) (format "sum=~a" s7))
;; 8) channel producer/consumer across fibers: 10k messages, none lost, order preserved
(define ch8 (channel:create 64))
(define prod (fiber:spawn (lambda () (let loop ((i 0)) (when (< i 10000) (channel:send ch8 i) (loop (+ i 1)))) 'done)))
(define cons8 (fiber:spawn (lambda () (let loop ((i 0) (ok #t)) (if (< i 10000) (let ((v (channel:recv ch8))) (loop (+ i 1) (and ok (equal? v i)))) ok)))))
(define t8 (monotonic-ms))
(define p8 (safe (lambda () (fiber:join prod)) 'raised))
(define c8 (safe (lambda () (fiber:join cons8)) 'raised))
(bench! "fiber.chan10k.ms" (- (monotonic-ms) t8) "ms")
(check! "fiber.chan10k.ordered" (and (eq? p8 'done) (eq? c8 #t)) (format "prod=~a cons=~a" p8 c8))
(emit "done" "ok")
