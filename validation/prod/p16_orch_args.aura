;; p16_orch_args -- orch keyword validation and duplicate live names (aura#4867), ask/reply with a blocking-recv worker
(define (raises? th) (try (begin (th) #f) (catch (e) #t)))
(define (spin-ms ms) (let ((t (+ (monotonic-ms) ms))) (let loop () (when (< (monotonic-ms) t) (fiber:yield) (loop)))))
(orch:scope-spawn "p16-a" (lambda () 1))
(check! "orch.args.timeout-string-raises" (raises? (lambda () (orch:scope-join-all :timeout-ms "abc"))) "string :timeout-ms accepted")
(orch:scope-spawn "p16-b" (lambda () 1))
(check! "orch.args.unknown-keyword-raises" (raises? (lambda () (orch:scope-join-all :timeot-ms 100))) "typo keyword accepted")
(orch:scope-join-all :timeout-ms 1000)
(orch:spawn-agent "p16-n" (lambda () 1))
(check! "orch.args.agent-join-negative-raises" (raises? (lambda () (orch:agent-join "p16-n" :timeout-ms -1))) "negative timeout accepted")
(orch:agent-join "p16-n" :timeout-ms 1000)
(define p16-out (channel:create 4))
(define d1 (orch:spawn-agent "p16-d" (lambda () (spin-ms 50) (channel:send p16-out 'first) 'first)))
(define d2 (try (orch:spawn-agent "p16-d" (lambda () (channel:send p16-out 'second) 'second)) (catch (e) 'raised)))
(check! "orch.args.dup-live-name-denied" (or (eq? d2 'raised) (and (hash? d2) (eq? #f (hg d2 "ok" #t)))) (format "second spawn ~a" (if (hash? d2) (hg d2 "ok" '?) d2)))
(define dj (orch:agent-join "p16-d" :timeout-ms 2000))
(check! "orch.args.dup-first-runs" (and (eq? #t (hg dj "ok" #f)) (equal? 'first (channel:try-recv p16-out)) (equal? "" (channel:try-recv p16-out))) (format "join ~a" (hg dj "status" '?)))
;; blocking-recv ask/reply worker that exits on its own (an idle blocking worker at process exit segfaults: aura#4871)
(orch:spawn-agent "p16-w" (lambda ()
  (let loop ((n 0))
    (if (< n 3)
        (let ((m (orch:agent-recv "p16-w" :wait #t :timeout-ms 3000)))
          (if (eq? #t (hg m "ok" #f)) (begin (orch:agent-reply (hg m "correlation-id" 0) (format "r~a" n)) (loop (+ n 1))) 'timeout))
        'served))) :attach-mailbox #t)
(define asks (map (lambda (i) (orch:agent-ask "p16-w" (number->string i) :timeout-ms 2000)) (range 3)))
(check! "orch.ask.blocking-worker" (= 3 (count-if (lambda (a) (eq? #t (hg a "ok" #f))) asks)) (format "ok ~a/3" (count-if (lambda (a) (eq? #t (hg a "ok" #f))) asks)))
(define wj (orch:agent-join "p16-w" :timeout-ms 3000))
(check! "orch.ask.blocking-worker-joins" (eq? #t (hg wj "ok" #f)) (format "join ~a" (hg wj "status" '?)))
(emit "done" "ok")
