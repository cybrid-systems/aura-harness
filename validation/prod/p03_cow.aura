;; p03_cow -- COW overlays under concurrent mutation: no lost update, isolation, rollback.
(set-code "(define p03-seed 0)")
(eval-current)
(fiber:overlay-begin)
(fiber:overlay-define "p03-ctr" 0)
(fiber:overlay-commit)
;; K fibers x R increments, optimistic retry on conflict: the counter must be exactly K*R
(define K 8)
(define R 25)
(define (inc-once)
  (let loop ((tries 1))
    (fiber:overlay-begin)
    (let ((v (fiber:overlay-get "p03-ctr" -1000000)))
      (fiber:overlay-set! "p03-ctr" (+ v 1))
      (fiber:yield)
      (if (error? (fiber:overlay-commit)) (loop (+ tries 1)) tries))))
(define (worker) (let loop ((i 0) (retries 0)) (if (< i R) (loop (+ i 1) (+ retries (- (inc-once) 1))) retries)))
(define t0 (monotonic-ms))
(define fs (map (lambda (k) (fiber:spawn worker)) (range K)))
(define retries (map (lambda (f) (safe (lambda () (fiber:join f)) 'raised)) fs))
(bench! "cow.ctr.ms" (- (monotonic-ms) t0) "ms")
(info! "cow.ctr.retries" retries)
(define final (fiber:overlay-get "p03-ctr" -1))
(check! "cow.ctr.no-lost-update" (equal? final (* K R)) (format "counter=~a want ~a" final (* K R)))
(check! "cow.ctr.workers-ok" (all? number? retries) (format "worker results ~a" retries))
;; rollback leaves nothing behind, even after many rounds
(define (rb-round i) (fiber:overlay-begin) (fiber:overlay-define (format "p03-tmp-~a" i) i) (fiber:overlay-rollback))
(for-each rb-round (range 200))
(check! "cow.rollback.nothing-visible" (all? (lambda (i) (equal? (fiber:overlay-get (format "p03-tmp-~a" i) 'none) 'none)) (range 200)) "rolled-back names visible")
(define rep (safe (lambda () (fiber:overlay-report)) #f))
(info! "cow.report" (if (hash? rep) (map (lambda (k) (cons k (hash-ref rep k))) (hash-keys rep)) rep))
(emit "done" "ok")
