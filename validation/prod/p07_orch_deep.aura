;; p07_orch_deep -- join report schema (docs/orch-join-report.md, #4832), scope edge cases, nesting.
(define (spin-ms ms) (let ((t (+ (monotonic-ms) ms))) (let loop () (when (< (monotonic-ms) t) (fiber:yield) (loop)))))
(define (keys h) (if (hash? h) (sorted-strs (map str (hash-keys h))) (list)))
(define (markers ks) (filter (lambda (k) (or (string-contains? k "issue-") (string-contains? k "schema-") (string-contains? k "-wired"))) ks))
(define agent-doc (list "ok" "status" "wait-us" "drain-ms" "schema" "error"))
(define scope-doc (list "ok" "status" "err-count" "errors" "body-ok-count" "cancelled-count" "wait-us" "drain-ms" "schema"
  "reclaimed-count" "must-wait-count" "reservation-held-count" "cleanup-pending-count" "wait-reclaimed" "wait-timeout"
  "on-join-fail-effective" "join-fail-action-taken" "restart-attempted" "restart-skipped-no-spec" "restart-ok" "restart-denied"
  "restart-deny-class" "tree" "tree-settled" "descendants-live" "swept-cleaned" "swept-still-pending" "isolation-level"
  "restart-max" "restart-exhausted" "attempt-errors" ;; documented by aura#4868 (dd7da85c0)
  "region-key-missing" "region-key-missing-serialized" "distinct-region-keys"))
(define (undocumented ks doc) (filter (lambda (k) (not (member k doc))) ks))
;; 1) agent-join default report == documented keys, no markers; :debug is a superset
(orch:spawn-agent "p07-a" (lambda () 1))
(define ja (orch:agent-join "p07-a" :timeout-ms 3000))
(define ka (keys ja))
(info! "orch.agent-join.keys" ka)
(check! "observe.agent-join.no-markers" (null? (markers ka)) (format "markers ~a" (markers ka)))
(check! "observe.agent-join.documented" (null? (undocumented ka agent-doc)) (format "undocumented ~a" (undocumented ka agent-doc)))
(orch:spawn-agent "p07-b" (lambda () 1))
(define jd (orch:agent-join "p07-b" :timeout-ms 3000 :debug #t))
(check! "observe.agent-join.debug-superset" (all? (lambda (k) (member k (keys jd))) ka) (format "debug keys ~a" (length (keys jd))))
;; 2) scope-join default report: documented keys only, errors list matches err-count
(orch:scope-spawn "p07-s1" (lambda () (error "e1")))
(orch:scope-spawn "p07-s2" (lambda () 2))
(orch:scope-spawn "p07-s3" (lambda () (raise 'e3)))
(define sj (orch:scope-join-all :timeout-ms 3000))
(define ks (keys sj))
(info! "orch.scope-join.keys" (length ks))
(check! "observe.scope-join.no-markers" (null? (markers ks)) (format "markers ~a" (markers ks)))
(check! "observe.scope-join.documented" (null? (undocumented ks scope-doc)) (format "undocumented ~a" (undocumented ks scope-doc)))
(define errs (hg sj "errors" 'missing))
(check! "observe.scope-join.errors-list" (and (list? errs) (= (length errs) (hg sj "err-count" -1)))
        (format "errors=~a err-count=~a" errs (hg sj "err-count" -1)))
(check! "observe.scope-join.counts-add-up" (equal? (+ (hg sj "err-count" 0) (hg sj "body-ok-count" 0)) 3)
        (format "err=~a ok=~a" (hg sj "err-count" 'x) (hg sj "body-ok-count" 'x)))
(check! "observe.scope-join.status-partial" (member (str (hg sj "status" "")) (list "partial" "error"))
        (format "status=~a ok=~a" (hg sj "status" 'x) (hg sj "ok" 'x)))
;; 3) joining with no live scope (everything already joined): must not crash; record what it does
(define sj0 (try (orch:scope-join-all :timeout-ms 500) (catch (e) (format "raised: ~a" e))))
(info! "orch.scope-join.no-scope" (if (hash? sj0) (format "ok=~a status=~a" (hg sj0 "ok" 'x) (hg sj0 "status" 'x)) sj0))
;; 4) timeout: a body outliving :timeout-ms gives ok #f / status timeout, join returns near the deadline
(orch:scope-spawn "p07-slow" (lambda () (spin-ms 3000) 'late))
(define t4 (monotonic-ms))
(define sjt (orch:scope-join-all :timeout-ms 300))
(define w4 (- (monotonic-ms) t4))
(info! "orch.scope-join.timeout-report" (format "ok=~a status=~a after ~a ms" (hg sjt "ok" 'x) (hg sjt "status" 'x) w4))
(check! "orch.scope-join.timeout-not-ok" (eq? #f (hg sjt "ok" 'x)) (format "ok=~a status=~a" (hg sjt "ok" 'x) (hg sjt "status" 'x)))
(check! "orch.scope-join.timeout-prompt" (< w4 2000) (format "~a ms for :timeout-ms 300" w4))
(safe (lambda () (orch:scope-cancel-all)) #f)
(safe (lambda () (orch:scope-join-all :timeout-ms 4000)) #f)
;; 5) unknown agent: join / ask / send answer ok #f or raise a clear "unknown agent" error, quickly
(define t5 (monotonic-ms))
(define ju (safe (lambda () (orch:agent-join "p07-nobody" :timeout-ms 300)) 'raised))
(define au (try (orch:agent-ask "p07-nobody" "x" :timeout-ms 300) (catch (e) (str e))))
(define su (try (orch:agent-send "p07-nobody" "x") (catch (e) (str e))))
(define (refused? r) (or (and (hash? r) (eq? #f (hg r "ok" 'x))) (and (string? r) (string-contains? r "unknown agent"))))
(info! "orch.unknown-agent" (format "join=~a/~a ask=~a/~a send=~a" (hg ju "ok" ju) (hg ju "status" 'x) (hg au "ok" au) (hg au "status" 'x) (hg su "ok" su)))
(check! "orch.unknown-agent.refused" (and (refused? ju) (refused? au) (refused? su))
        (format "join=~a ask=~a send=~a" (hg ju "ok" ju) (hg au "ok" au) (hg su "ok" su)))
(check! "orch.unknown-agent.prompt" (< (- (monotonic-ms) t5) 2000) (format "~a ms" (- (monotonic-ms) t5)))
;; 6) nested: an agent body that itself spawns a scope and joins it; result and errors bubble up
(orch:spawn-agent "p07-parent" (lambda ()
  (orch:scope-spawn "p07-kid1" (lambda () 10))
  (orch:scope-spawn "p07-kid2" (lambda () (error "kid2 failed")))
  (let ((r (orch:scope-join-all :timeout-ms 2000)))
    (if (eq? #t (hg r "ok" #f)) 'all-ok (error (format "children failed: ~a" (hg r "err-count" -1)))))))
(define jp (orch:agent-join "p07-parent" :timeout-ms 4000))
(check! "orch.nested.child-error-bubbles" (and (eq? #f (hg jp "ok" 'x)) (string-contains? (str (hg jp "error" "")) "children failed: 1"))
        (format "ok=~a status=~a error=~a" (hg jp "ok" 'x) (hg jp "status" 'x) (hg jp "error" 'x)))
;; 7) 200 agents spawned then joined: all ok, throughput
(define t7 (monotonic-ms))
(for-each (lambda (i) (orch:spawn-agent (format "p07-m~a" i) (lambda () (* i i)))) (range 200))
(define okn (count-if (lambda (i) (eq? #t (hg (orch:agent-join (format "p07-m~a" i) :timeout-ms 3000) "ok" #f))) (range 200)))
(bench! "orch.agents200.ms" (- (monotonic-ms) t7) "ms")
(check! "orch.agents200.all-ok" (= okn 200) (format "~a/200" okn))
;; 8) re-spawn the same agent name after it was joined works
(orch:spawn-agent "p07-re" (lambda () 1))
(orch:agent-join "p07-re" :timeout-ms 2000)
(define rs (safe (lambda () (orch:spawn-agent "p07-re" (lambda () 2))) 'raised))
(define jr (orch:agent-join "p07-re" :timeout-ms 2000))
(check! "orch.respawn-after-join" (eq? #t (hg jr "ok" #f)) (format "spawn=~a join status=~a" (hg rs "ok" rs) (hg jr "status" 'x)))
;; 9) orch:metrics is serve-async only (empty on the CLI thread backend); record what the CLI sees
(info! "observe.orch-metrics.cli" (format "~a" (safe (lambda () (stats:get "orch:metrics")) 'raised)))
(emit "done" "ok")
