;; p13_leak -- RSS growth per operation class over 10 batches (warm-up batch excluded). Reports kB/batch slope.
(define (spin-ms ms) (let ((t (+ (monotonic-ms) ms))) (let loop () (when (< (monotonic-ms) t) (fiber:yield) (loop)))))
(define (measure id batches per thunk limit-kb)
  (thunk per) (safe (lambda () (gc-heap)) #f)
  (let* ((r0 (rss-kb))
         (rs (map (lambda (b) (thunk per) (safe (lambda () (gc-heap)) #f) (rss-kb)) (range batches)))
         (r1 (list-ref rs (- batches 1)))
         (half (list-ref rs (- (quotient batches 2) 1)))
         (late (- r1 half)))
    (info! (string-append "leak." id ".rss") rs)
    (bench! (string-append "leak." id ".kb-per-batch") (r3 (/ (- r1 r0) (* 1.0 batches))) "kB")
    (check! (string-append "leak." id ".bounded") (< late limit-kb) (format "second-half growth ~a kB (r0=~a r1=~a, ~a ops/batch)" late r0 r1 per))))
(measure "fiber-spawn-join" 10 2000 (lambda (n) (for-each (lambda (i) (fiber:join (fiber:spawn (lambda () i)))) (range n))) 4096)
(measure "fiber-raise-join" 10 1000 (lambda (n) (for-each (lambda (i) (safe (lambda () (fiber:join (fiber:spawn (lambda () (raise 'x))))) #f)) (range n))) 4096)
(define ac 0)
(measure "agent-spawn-join" 10 200 (lambda (n) (for-each (lambda (i) (set! ac (+ ac 1)) (orch:spawn-agent (format "p13-a~a" ac) (lambda () i)) (orch:agent-join (format "p13-a~a" ac) :timeout-ms 3000)) (range n))) 4096)
(measure "agent-error-join" 10 200 (lambda (n) (for-each (lambda (i) (set! ac (+ ac 1)) (orch:spawn-agent (format "p13-e~a" ac) (lambda () (error "e"))) (orch:agent-join (format "p13-e~a" ac) :timeout-ms 3000)) (range n))) 4096)
(measure "scope-batch" 10 20 (lambda (n) (for-each (lambda (i) (for-each (lambda (k) (set! ac (+ ac 1)) (orch:scope-spawn (format "p13-s~a" ac) (lambda () k))) (range 10)) (orch:scope-join-all :timeout-ms 3000)) (range n))) 4096)
(fiber:overlay-begin) (fiber:overlay-define "p13-k" 0) (fiber:overlay-commit)
(measure "overlay-tx" 10 2000 (lambda (n) (for-each (lambda (i) (fiber:overlay-begin) (fiber:overlay-set! "p13-k" i) (fiber:overlay-commit)) (range n))) 4096)
(measure "overlay-rollback" 10 2000 (lambda (n) (for-each (lambda (i) (fiber:overlay-begin) (fiber:overlay-set! "p13-k" i) (fiber:overlay-rollback)) (range n))) 4096)
(measure "channel-create" 10 2000 (lambda (n) (for-each (lambda (i) (let ((c (channel:create 4))) (channel:send c i) (channel:recv c))) (range n))) 4096)
(measure "eval-datum" 10 500 (lambda (n) (for-each (lambda (i) (eval (list '+ i 1))) (range n))) 4096)
(measure "string-hash" 10 2000 (lambda (n) (for-each (lambda (i) (let ((h (hash))) (hash-set! h (format "k~a" i) (format "v~a" i)) (hash-ref h (format "k~a" i)))) (range n))) 4096)
(measure "try-catch" 10 5000 (lambda (n) (for-each (lambda (i) (try (raise i) (catch (e) e))) (range n))) 4096)
(emit "done" "ok")
