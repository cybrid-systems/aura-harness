;; p08_cow_edge -- COW overlay edge cases: isolation, misuse, abandoned transactions, scale.
(define (show x) (if (hash? x) (map (lambda (k) (cons k (hash-ref x k))) (hash-keys x)) x))
(fiber:overlay-begin) (fiber:overlay-define "p08-k" 1) (fiber:overlay-commit)
;; 1) isolation: an uncommitted write in fiber A is invisible to fiber B, visible to A itself
(define ch (channel:create 4))
(define go (channel:create 4))
(define fa (fiber:spawn (lambda ()
  (fiber:overlay-begin)
  (fiber:overlay-set! "p08-k" 99)
  (channel:send ch (fiber:overlay-get "p08-k" -1))
  (recv-within go 5000)
  (fiber:overlay-commit))))
(define self-view (recv-within ch 3000))
(define other-view (fiber:join (fiber:spawn (lambda () (fiber:overlay-get "p08-k" -1)))))
(define main-view (fiber:overlay-get "p08-k" -1))
(check! "cow.isolation.self-sees-own-write" (equal? self-view 99) (format "self=~a" self-view))
(check! "cow.isolation.others-see-old" (and (equal? other-view 1) (equal? main-view 1)) (format "other=~a main=~a" other-view main-view))
(channel:send go 'commit)
(define ca (safe (lambda () (fiber:join fa)) 'raised))
(check! "cow.isolation.visible-after-commit" (equal? (fiber:overlay-get "p08-k" -1) 99) (format "after commit ~a (commit=~a)" (fiber:overlay-get "p08-k" -1) (show ca)))
;; 2) misuse outside a transaction: set!/commit/rollback without begin must be a clear error or no-op, never crash
(define m1 (try (show (fiber:overlay-set! "p08-k" 5)) (catch (e) (format "raised:~a" e))))
(define m2 (try (show (fiber:overlay-commit)) (catch (e) (format "raised:~a" e))))
(define m3 (try (show (fiber:overlay-rollback)) (catch (e) (format "raised:~a" e))))
(info! "cow.misuse" (format "set!=~a | commit=~a | rollback=~a" m1 m2 m3))
(info! "cow.misuse.set-outside-tx-effect" (format "value after set! outside tx: ~a" (fiber:overlay-get "p08-k" -1)))
(check! "cow.misuse.set-outside-tx-no-write" (equal? (fiber:overlay-get "p08-k" -1) 99) (format "set! without begin wrote through: value=~a (set!=~a)" (fiber:overlay-get "p08-k" -1) m1))
(fiber:overlay-begin) (fiber:overlay-set! "p08-k" 99) (fiber:overlay-commit)
;; 3) a fiber that raises inside an open transaction: its writes never become visible, key still usable
(define fr (fiber:spawn (lambda () (fiber:overlay-begin) (fiber:overlay-set! "p08-k" -7) (raise 'abort-tx))))
(safe (lambda () (fiber:join fr)) 'raised)
(check! "cow.raise-in-tx.no-leak" (equal? (fiber:overlay-get "p08-k" -1) 99) (format "value=~a" (fiber:overlay-get "p08-k" -1)))
(define after (fiber:join (fiber:spawn (lambda () (fiber:overlay-begin) (fiber:overlay-set! "p08-k" 100) (fiber:overlay-commit)))))
(check! "cow.raise-in-tx.key-still-committable" (and (not (error? after)) (equal? (fiber:overlay-get "p08-k" -1) 100)) (format "commit=~a value=~a" (show after) (fiber:overlay-get "p08-k" -1)))
;; 4) a cancelled fiber with an open transaction leaves nothing behind
(define fc (fiber:spawn (lambda () (fiber:overlay-begin) (fiber:overlay-set! "p08-k" -9) (let loop () (fiber:yield) (loop)))))
(fiber:yield) (fiber:yield)
(fiber:cancel fc)
(safe (lambda () (fiber:join fc)) 'raised)
(check! "cow.cancel-in-tx.no-leak" (equal? (fiber:overlay-get "p08-k" -1) 100) (format "value=~a" (fiber:overlay-get "p08-k" -1)))
(define after2 (fiber:join (fiber:spawn (lambda () (fiber:overlay-begin) (fiber:overlay-set! "p08-k" 101) (fiber:overlay-commit)))))
(check! "cow.cancel-in-tx.key-still-committable" (equal? (fiber:overlay-get "p08-k" -1) 101) (format "commit=~a value=~a" (show after2) (fiber:overlay-get "p08-k" -1)))
;; 5) write-write conflict: two transactions on the same key, both begun (barrier) before either commits -> exactly one wins
(define g (channel:create 8))
(define go1 (channel:create 2))
(define go2 (channel:create 2))
(define (lost? c) (or (error? c) (and (pair? c) (eq? (car c) 'conflict))))
(define (writer v go) (lambda () (fiber:overlay-begin) (fiber:overlay-set! "p08-k" v) (channel:send g 'ready) (recv-within go 5000)
  (try (fiber:overlay-commit) (catch (e) (list 'conflict (str e))))))
(define w1 (fiber:spawn (writer 201 go1)))
(define w2 (fiber:spawn (writer 202 go2)))
(define rdy (list (recv-within g 5000) (recv-within g 5000)))
(channel:send go1 'go)
(define c1 (fiber:join w1))
(channel:send go2 'go)
(define c2 (fiber:join w2))
(define wins (count-if (lambda (c) (not (lost? c))) (list c1 c2)))
(info! "cow.ww-conflict" (format "ready=~a c1=~a c2=~a final=~a" rdy (show c1) (show c2) (fiber:overlay-get "p08-k" -1)))
(check! "cow.ww-conflict.one-winner" (= wins 1) (format "~a commits succeeded" wins))
(check! "cow.ww-conflict.first-committer-wins" (and (not (lost? c1)) (equal? (fiber:overlay-get "p08-k" -1) 201)) (format "final=~a" (fiber:overlay-get "p08-k" -1)))
;; 6) scale: one transaction defining 5000 names, commit time, then reads
(define t6 (monotonic-ms))
(fiber:overlay-begin)
(for-each (lambda (i) (fiber:overlay-define (format "p08-big-~a" i) i)) (range 5000))
(define cb (fiber:overlay-commit))
(bench! "cow.define5000.commit-ms" (- (monotonic-ms) t6) "ms")
(define t6b (monotonic-ms))
(define rd (count-if (lambda (i) (equal? (fiber:overlay-get (format "p08-big-~a" i) -1) i)) (range 5000)))
(bench! "cow.get5000.ms" (- (monotonic-ms) t6b) "ms")
(check! "cow.define5000.all-visible" (= rd 5000) (format "~a/5000 commit=~a" rd (show cb)))
;; 7) 32 fibers each committing its own key 20 times: no conflicts expected on disjoint keys
;; keys are defined first: since aura#4845 overlay-set! on an unbound name is an error
(for-each (lambda (k) (fiber:overlay-begin) (fiber:overlay-define (format "p08-own-~a" k) -1) (fiber:overlay-commit)) (range 32))
(define t7 (monotonic-ms))
(define d7 (map (lambda (k) (fiber:spawn (lambda ()
  (let loop ((i 0) (fails 0)) (if (< i 20)
    (begin (fiber:overlay-begin) (fiber:overlay-set! (format "p08-own-~a" k) i) (fiber:yield)
           (loop (+ i 1) (+ fails (if (lost? (try (fiber:overlay-commit) (catch (e) (list 'conflict (str e))))) 1 0)))) fails))))) (range 32)))
(define f7 (map (lambda (f) (safe (lambda () (fiber:join f)) 'raised)) d7))
(bench! "cow.disjoint32x20.ms" (- (monotonic-ms) t7) "ms")
(info! "cow.disjoint.fails" f7)
(check! "cow.disjoint.no-false-conflicts" (all? (lambda (x) (equal? x 0)) f7) (format "fails per fiber ~a" f7))
(info! "cow.report" (show (safe (lambda () (fiber:overlay-report)) 'raised)))
(emit "done" "ok")
