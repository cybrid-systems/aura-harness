;; p04_gc -- safepoint gc-heap (aura#4816) under a live heap: values survive, garbage is reclaimed.
(define keep-list (map (lambda (i) (cons i (format "v~a" i))) (range 2000)))
(define keep-hash (hash))
(for-each (lambda (i) (hash-set! keep-hash (format "k~a" i) (list i i))) (range 500))
(define (garbage n) (let loop ((i 0)) (when (< i n) (cons i (cons i i)) (loop (+ i 1)))))
(define r0 (rss-kb))
(define results (map (lambda (round) (garbage 20000) (safe (lambda () (gc-heap)) 'raised)) (range 20)))
(bench! "gc.20rounds.rss-delta" (- (rss-kb) r0) "kB")
(info! "gc.results" results)
(check! "gc.returns-bool" (all? boolean? results) (format "~a" (list-head-safe results 3)))
(check! "gc.list-survives" (and (= (length keep-list) 2000) (equal? (cdr (list-ref keep-list 1999)) "v1999")) "keep-list damaged")
(check! "gc.hash-survives" (equal? (hash-ref keep-hash "k499") (list 499 499)) "keep-hash damaged")
(define st (stat "gc-heap-stats"))
(check! "gc.stats-present" (hash? st) (format "~a" st))
(info! "gc.stats" (if (hash? st) (map (lambda (k) (cons k (hash-ref st k))) (hash-keys st)) st))
;; gc-heap inside a fiber must not crash (aura#4812/#4816)
(define fr (safe (lambda () (fiber:join (fiber:spawn (lambda () (garbage 1000) (gc-heap))))) 'raised))
(check! "gc.in-fiber" (or (boolean? fr) (eq? fr 'raised)) (format "~a" fr))
(check! "gc.list-survives-after-fiber" (equal? (car (list-ref keep-list 7)) 7) "keep-list damaged")
(emit "done" "ok")
