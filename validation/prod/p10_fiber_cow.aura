;; p10_fiber_cow -- fiber x COW interaction: tx spanning yields, child fibers inside a tx, agents doing tx, counters.
(fiber:overlay-begin) (fiber:overlay-define "p10-c" 0) (fiber:overlay-define "p10-x" 'init) (fiber:overlay-commit)
(define (commit-ok? c) (and (not (error? c)) (not (eq? c #f))))
;; 1) read-modify-write counter: 16 fibers x 20 increments, retry on conflict, yield inside tx -> no lost update
(define (incr-once)
  (let retry ((n 0))
    (fiber:overlay-begin)
    (let ((v (fiber:overlay-get "p10-c" -1)))
      (fiber:yield)
      (fiber:overlay-set! "p10-c" (+ v 1))
      (let ((c (try (fiber:overlay-commit) (catch (e) #f))))
        (if (commit-ok? c) n (begin (safe (lambda () (fiber:overlay-rollback)) #f) (if (< n 200) (retry (+ n 1)) 'gave-up)))))))
(define t1 (monotonic-ms))
(define fs (map (lambda (i) (fiber:spawn (lambda () (let loop ((k 0) (r 0)) (if (< k 20) (let ((x (incr-once))) (loop (+ k 1) (if (number? x) (+ r x) 999999))) r))))) (range 16)))
(define retries (map (lambda (f) (safe (lambda () (fiber:join f)) 'raised)) fs))
(bench! "cowfiber.counter320.ms" (- (monotonic-ms) t1) "ms")
(info! "cowfiber.counter.retries" retries)
(check! "cowfiber.counter.no-lost-update" (equal? (fiber:overlay-get "p10-c" -1) 320) (format "final=~a retries=~a" (fiber:overlay-get "p10-c" -1) retries))
;; 2) a child fiber spawned inside an open tx: what does it see, and can its write leak past the parent's rollback?
(define child-view
  (fiber:join (fiber:spawn (lambda ()
    (fiber:overlay-begin)
    (fiber:overlay-set! "p10-x" 'parent-uncommitted)
    (let ((cv (fiber:join (fiber:spawn (lambda () (fiber:overlay-get "p10-x" 'none))))))
      (fiber:overlay-rollback)
      cv)))))
(info! "cowfiber.child-in-tx.sees" child-view)
(check! "cowfiber.child-in-tx.no-dirty-read" (not (equal? child-view 'parent-uncommitted)) (format "child saw ~a" child-view))
(check! "cowfiber.rollback.restores" (equal? (fiber:overlay-get "p10-x" 'none) 'init) (format "after rollback ~a" (fiber:overlay-get "p10-x" 'none)))
;; 3) a fiber that begins a tx and ends without commit/rollback: the dangling tx must not stay visible or block others
(fiber:join (fiber:spawn (lambda () (fiber:overlay-begin) (fiber:overlay-set! "p10-x" 'dangling) 'exit-without-commit)))
(check! "cowfiber.dangling-tx.invisible" (equal? (fiber:overlay-get "p10-x" 'none) 'init) (format "value=~a" (fiber:overlay-get "p10-x" 'none)))
(define c3 (fiber:join (fiber:spawn (lambda () (fiber:overlay-begin) (fiber:overlay-set! "p10-x" 'after) (fiber:overlay-commit)))))
(check! "cowfiber.dangling-tx.key-committable" (equal? (fiber:overlay-get "p10-x" 'none) 'after) (format "commit=~a value=~a" c3 (fiber:overlay-get "p10-x" 'none)))
;; 4) nested begin inside the same fiber: error or flat nesting, never corrupt
(define nb (try (fiber:join (fiber:spawn (lambda () (fiber:overlay-begin) (fiber:overlay-begin) (fiber:overlay-set! "p10-x" 'nested) (list (fiber:overlay-commit) (fiber:overlay-commit))))) (catch (e) (format "raised:~a" e))))
(info! "cowfiber.nested-begin" (format "~a value=~a" nb (fiber:overlay-get "p10-x" 'none)))
;; 5) agents doing COW tx concurrently on disjoint keys (orch + cow)
(for-each (lambda (i) (fiber:overlay-begin) (fiber:overlay-define (format "p10-ag~a" i) 0) (fiber:overlay-commit)) (range 12))
(for-each (lambda (i) (orch:spawn-agent (format "p10-ag~a" i) (lambda ()
   (let loop ((k 0)) (when (< k 25) (fiber:overlay-begin) (fiber:overlay-set! (format "p10-ag~a" i) (+ 1 (fiber:overlay-get (format "p10-ag~a" i) 0))) (fiber:overlay-commit) (fiber:yield) (loop (+ k 1))))
   (fiber:overlay-get (format "p10-ag~a" i) -1)))) (range 12))
(define aj (map (lambda (i) (orch:agent-join (format "p10-ag~a" i) :timeout-ms 8000)) (range 12)))
(define av (map (lambda (i) (fiber:overlay-get (format "p10-ag~a" i) -1)) (range 12)))
(check! "cowfiber.agents-disjoint.all-ok" (all? (lambda (j) (eq? #t (hg j "ok" #f))) aj) (format "~a" (map (lambda (j) (list (hg j "status" 'x) (hg j "error" ""))) aj)))
(check! "cowfiber.agents-disjoint.values" (all? (lambda (v) (equal? v 25)) av) (format "~a" av))
;; 6) cancel 32 fibers each holding an open tx mid-loop; afterwards the keys are clean and committable
(for-each (lambda (i) (fiber:overlay-begin) (fiber:overlay-define (format "p10-cc~a" i) 0) (fiber:overlay-commit)) (range 32))
(define cf (map (lambda (i) (fiber:spawn (lambda () (fiber:overlay-begin) (fiber:overlay-set! (format "p10-cc~a" i) -1) (let loop () (fiber:yield) (loop))))) (range 32)))
(fiber:yield) (fiber:yield) (fiber:yield)
(for-each (lambda (f) (safe (lambda () (fiber:cancel f)) #f)) cf)
(for-each (lambda (f) (safe (lambda () (fiber:join f)) #f)) cf)
(define cv (map (lambda (i) (fiber:overlay-get (format "p10-cc~a" i) 'none)) (range 32)))
(check! "cowfiber.cancel32.no-leak" (all? (lambda (v) (equal? v 0)) cv) (format "~a" (list-head-safe cv 6)))
(define cc (map (lambda (i) (fiber:join (fiber:spawn (lambda () (fiber:overlay-begin) (fiber:overlay-set! (format "p10-cc~a" i) 7) (fiber:overlay-commit))))) (range 32)))
(check! "cowfiber.cancel32.committable" (all? (lambda (i) (equal? (fiber:overlay-get (format "p10-cc~a" i) 'none) 7)) (range 32)) (format "~a" (list-head-safe cc 3)))
(emit "done" "ok")
