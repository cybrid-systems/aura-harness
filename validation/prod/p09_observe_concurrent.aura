;; p09_observe_concurrent -- join reports under many concurrently running agents; per-agent errors stay with their agent.
(define (spin-ms ms) (let ((t (+ (monotonic-ms) ms))) (let loop () (when (< (monotonic-ms) t) (fiber:yield) (loop)))))
(define N 48)
(define (nm i) (format "p09-a~a" i))
;; 1) 48 agents running at once, mixed: i%4==0 errors "fail-i", i%4==1 raises symbol, else returns i after spinning
(for-each (lambda (i)
  (orch:spawn-agent (nm i) (lambda ()
    (spin-ms (* 5 (modulo i 7)))
    (cond ((= 0 (modulo i 4)) (error (format "fail-~a" i)))
          ((= 1 (modulo i 4)) (raise (string->symbol (format "sym-~a" i))))
          (else i))))) (range N))
(define t1 (monotonic-ms))
(define js (map (lambda (i) (orch:agent-join (nm i) :timeout-ms 5000)) (range N)))
(bench! "observe.join48.ms" (- (monotonic-ms) t1) "ms")
(define (expect-ok i) (> (modulo i 4) 1))
(define wrong (filter (lambda (p) (let ((i (car p)) (j (cdr p)))
   (cond ((expect-ok i) (not (and (eq? #t (hg j "ok" 'x)) (equal? (str (hg j "status" "")) "ok"))))
         ((= 0 (modulo i 4)) (not (and (eq? #f (hg j "ok" 'x)) (string-contains? (str (hg j "error" "")) (format "fail-~a" i)))))
         (else (not (and (eq? #f (hg j "ok" 'x)) (string-contains? (str (hg j "error" "")) (format "sym-~a" i))))))))
   (map cons (range N) js)))
(check! "observe.concurrent48.status-per-agent" (null? wrong)
  (format "~a wrong, first ~a" (length wrong) (map (lambda (p) (list (car p) (hg (cdr p) "status" 'x) (hg (cdr p) "error" 'x))) (list-head-safe wrong 3))))
(check! "observe.concurrent48.same-keyset" (= 1 (distinct-count (map (lambda (j) (str (sorted-strs (map str (filter (lambda (k) (not (equal? (str k) "error"))) (hash-keys j)))))) js))) "key sets differ")
(check! "observe.concurrent48.wait-us-int" (all? (lambda (j) (and (integer? (hg j "wait-us" #f)) (>= (hg j "wait-us" -1) 0))) js) "wait-us missing/negative")
;; 2) concurrent scopes: 8 agents each run their own scope of 6 kids (2 fail); each agent reports its own err-count
(for-each (lambda (a)
  (orch:spawn-agent (format "p09-p~a" a) (lambda ()
    (for-each (lambda (k) (orch:scope-spawn (format "p09-p~a-k~a" a k) (lambda () (spin-ms 3) (if (< k 2) (error (format "kid-~a-~a" a k)) k)))) (range 6))
    (let ((r (orch:scope-join-all :timeout-ms 4000)))
      (let ((sig (format "~a/~a/~a" (hg r "err-count" -1) (hg r "body-ok-count" -1) (length (hg r "errors" (list))))))
        (if (equal? sig "2/4/2") 'ok (error (format "scope-sig ~a" sig)))))))) (range 8))
(define pj (map (lambda (a) (orch:agent-join (format "p09-p~a" a) :timeout-ms 8000)) (range 8)))
(info! "observe.concurrent-scopes.join" (map (lambda (j) (hg j "status" 'x)) pj))
(check! "observe.concurrent-scopes.all-joined-ok" (all? (lambda (j) (eq? #t (hg j "ok" #f))) pj)
   (format "~a" (map (lambda (j) (list (hg j "status" 'x) (hg j "error" ""))) pj)))
;; 3) the main thread's own scope must not see the agents' children
(orch:scope-spawn "p09-main-kid" (lambda () 1))
(define mj (orch:scope-join-all :timeout-ms 3000))
(check! "observe.scope-isolation.main" (and (= (hg mj "err-count" -1) 0) (= (hg mj "body-ok-count" -1) 1))
   (format "err=~a ok=~a errors=~a" (hg mj "err-count" 'x) (hg mj "body-ok-count" 'x) (hg mj "errors" 'x)))
;; 4) stats:get from many fibers at once while agents run -- never crash, types stable
(for-each (lambda (i) (orch:spawn-agent (format "p09-bg~a" i) (lambda () (spin-ms 200) i))) (range 8))
(define sf (map (lambda (i) (fiber:spawn (lambda () (let loop ((k 0) (ok 0)) (if (< k 50) (loop (+ k 1) (if (hash? (safe (lambda () (stats:get "gc-heap-stats")) #f)) (+ ok 1) ok)) ok))))) (range 8)))
(define sres (map (lambda (f) (safe (lambda () (fiber:join f)) -1)) sf))
(for-each (lambda (i) (orch:agent-join (format "p09-bg~a" i) :timeout-ms 3000)) (range 8))
(check! "observe.stats-concurrent" (all? (lambda (x) (= x 50)) sres) (format "~a" sres))
(emit "done" "ok")
