;; P6 并行 worldline：N 个 fiber 各自 create/switch/rebind/eval 自己的子 workspace，读回自己的值。
;; aura-harness 的 Next steps 打算用并行 fiber 跑 worldline；这里看 workspace :switch 是否是 fiber 局部的。
(set-code "(define f (lambda (x) 0))") (eval-current)
(define N 8)
(define res (make-vector N -1))
(define (body i)
  (let ((w (workspace :create (string-append "fw" (number->string i)))))
    (workspace :switch w)
    (mutate:rebind "f" (string-append "(lambda (x) " (number->string (+ 100 i)) ")") "fiber") (eval-current)
    (fiber:yield)
    (vector-set! res i (try (f 0) (catch (e) -2)))
    (workspace :switch 0) (eval-current)
    i))
(define (spawn-all n) (let loop ((i 0) (acc (list))) (if (= i n) acc (loop (+ i 1) (cons (let ((k i)) (fiber:spawn (lambda () (body k)))) acc)))))
(define (run)
  (let ((fs (spawn-all N)))
    (for-each (lambda (x) (try (fiber:join x) (catch (e) (begin (display (list "join-error" e)) (newline))))) fs)
    (vector->list res)))
(define got (run))
(define want (let loop ((i 0) (acc (list))) (if (= i N) (reverse acc) (loop (+ i 1) (cons (+ 100 i) acc)))))
(display (list "got" got "root-f" (f 0) "active-ws" (try (workspace :current) (catch (e) "n/a")))) (newline)
(display (if (and (equal? got want) (= (f 0) 0)) "OK isolated" (if (= (f 0) 0) "CROSS-TALK" "CROSS-TALK+ROOT-CHANGED"))) (newline)
