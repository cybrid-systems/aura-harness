;; P4 provenance：merge 之后 root 的 mutation-log / last-mutation-provenance 是否记录了子的变更（#4729 的回归检查）
(set-code "(define f (lambda (x) 1))\n(define g (lambda (x) 1))") (eval-current)
(mutate:rebind "g" "(lambda (x) 5)" "root-before") (eval-current)
(define n0 (length (query :mutation-log 1000)))
(define w (workspace :create "cand"))
(workspace :switch w) (mutate:rebind "f" "(lambda (x) 2)" "child-edit") (eval-current)
(define cp (query:last-mutation-provenance))
(workspace :switch 0) (eval-current)
(workspace :merge w) (eval-current)
(define n1 (length (query :mutation-log 1000)))
(define lp (query:last-mutation-provenance))
(display (list "root-log-before" n0 "after-merge" n1)) (newline)
(display (list "child-prov" cp)) (newline)
(display (list "root-last-prov" lp)) (newline)
(display (if (and (>= n1 (+ n0 1)) (hash? lp)) "OK" "PROVENANCE-LOST")) (newline)
