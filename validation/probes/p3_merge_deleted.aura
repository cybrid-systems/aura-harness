;; P3 merge 一个已 delete 的 workspace / 重复 merge 同一个 child：应当报错，不应静默改 root。
(set-code "(define f (lambda (x) 1))") (eval-current)
(define w (workspace :create "cand"))
(workspace :switch w) (mutate:rebind "f" "(lambda (x) 2)" "child") (eval-current)
(workspace :switch 0) (eval-current)
(workspace :delete w)
(define r1 (try (workspace :merge w) (catch (e) (list "raised" e))))
(eval-current)
(display (list "merge-deleted" r1 "f" (f 0))) (newline)
(define w2 (workspace :create "cand2"))
(display (list "new-id" w2 "old-id" w "reused" (equal? w w2))) (newline)
(workspace :switch w2) (eval-current)
(display (list "fresh-child-f" (f 0))) (newline)
(workspace :switch 0) (eval-current)
(display (cond ((and (= (f 0) 1) (pair? r1) (equal? (car r1) "raised")) "OK raised, root untouched")
               ((= (f 0) 1) (string-append "SILENT-NOOP " (if (equal? w w2) "id-reused" "")))
               (else "ROOT-CHANGED"))) (newline)
