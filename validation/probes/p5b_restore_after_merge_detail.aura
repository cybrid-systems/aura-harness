(set-code "(define f (lambda (x) 1))\n(define g (lambda (x) 7))") (eval-current)
(define s0 (current-source :workspace))
(define w (workspace :create "cand"))
(workspace :switch w) (mutate:rebind "f" "(lambda (x) 2)" "child") (eval-current)
(workspace :switch 0) (eval-current)
(define snap (ast:snapshot "pre-merge"))
(display (list "snap" snap)) (newline)
(workspace :merge w) (eval-current)
(display (list "src-after-merge" (current-source :workspace))) (newline)
(display (list "restore" (ast:restore snap))) (newline)
(eval-current)
(display (list "src-after-restore" (current-source :workspace) "f" (f 0))) (newline)
(eval-current)
(display (list "2nd eval f" (f 0))) (newline)
(set-code (current-source :workspace)) (eval-current)
(display (list "after set-code f" (f 0))) (newline)
;; control: snapshot/rebind/restore without merge
(define snap2 (ast:snapshot "x"))
(mutate:rebind "g" "(lambda (x) 9)" "r") (eval-current)
(ast:restore snap2) (eval-current)
(display (list "control g" (g 0))) (newline)
