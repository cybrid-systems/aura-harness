;; P7h：每个周期 = 3 次 root rebind f + 1 次 trial(f)+merge；同一个 define 上 root rebind 与 merge 交替。每 25 周期打印耗时(ms)
(set-code "(define f (lambda (x) (cond ((equal? x \"a\") 1) (else 0))))\n(define g (lambda (x) (f x)))\n(define h (lambda (x) 0))") (eval-current)
(define (body k) (string-append "(lambda (x) (cond ((equal? x \"a\") " (number->string k) ") (else 0)))"))
(define (cycle i) (mutate:rebind "f" (body (+ i 7)) "root") (eval-current) (mutate:rebind "f" (body (+ i 8)) "root") (eval-current) (mutate:rebind "f" (body (+ i 9)) "root") (eval-current) (let ((w (workspace :create "t")))
  (workspace :switch w) (mutate:rebind "f" (body i) "trial") (eval-current)
  (workspace :switch 0) (eval-current) (workspace :merge w) (eval-current) (workspace :delete w)))
(define pts (list))
(define t0 (current-time-ms))
(let loop ((i 1)) (if (<= i 100) (begin (cycle i) (if (= 0 (modulo i 25)) (begin (set! pts (cons (- (current-time-ms) t0) pts)) (set! t0 (current-time-ms)))) (loop (+ i 1)))))
(display (list "N" 100 "ms-per-25-merges" (reverse pts) "g" (g "a") "workspaces" (length (workspace :list)))) (newline)
