;; aura/swarm.aura — orchestrator-free self-organizing workers on Aura fibers.
;; Agensh-style loop per worker: Gather -> Claim -> Act -> Verify -> Merge.
;; Infrastructure (no task assignment, no planning): shared append-only typed
;; board, per-worker mailbox channels, a versioned shared workspace with merge
;; and rollback. Every worker runs the SAME code (worker-turn id round); only
;; the id differs. See docs/swarm-design.md.
;;
;; Load form-by-form (aura_harness/swarm.py does this): serve-async `exec` of a
;; multi-form chunk drops plain defines (see docs/swarm-design.md, Aura bugs).

;; ---------------------------------------------------------------- toy task
;; K subtasks. Subtask i belongs to family g = i mod F and wants a root x of
;;   x^2 + g*x + 7 == 0 (mod P),  0 <= x < P,  with x mod 3 == i mod 3.
;; A family has 0..2 roots. Finding roots costs a scan of P candidates (done in
;; windows of W per Act); a FACT with a family's roots solves all its siblings
;; for ~free; a FAIL (family has no root / no root of the right class) lets
;; siblings close the subtask as proven-infeasible. Acceptance is re-checked.
(define P 997)
(define W 64)
(define cfg-K 256)
(define cfg-F 32)
(define cfg-N 8)
(define (fam i) (modulo i cfg-F))
(define (feq x g) (= (modulo (+ (* x x) (* g x) 7) P) 0))
(define (accept? i x) (and (>= x 0) (< x P) (feq x (fam i)) (= (modulo x 3) (modulo i 3))))
(define (proven-none? i roots) (let loop ((r roots)) (cond ((null? r) #t) ((accept? i (car r)) #f) (else (loop (cdr r))))))

;; ---------------------------------------------------------------- metrics
(define m (make-hash))
(define (bump! k n) (hash-set! m k (+ n (hash-ref m k 0))))
(define (tick-ms! k t0) (bump! k (- (monotonic-ms) t0)))

;; ---------------------------------------------------------------- shared context (board)
;; Append-only, typed, newest first. Entry: (seq type worker task payload round)
;; Types: OBSERVED FACT FAIL CLAIM RELEASE PATCH_SUMMARY ANNOUNCE.
(define board (list))
(define nb 0)
(define (board-post! type w task payload rnd)
  (set! nb (+ nb 1))
  (set! board (cons (list nb type w task payload rnd) board))
  (bump! "board-appends" 1)
  nb)
(define (e-seq e) (car e))
(define (e-type e) (cadr e))
(define (e-w e) (caddr e))
(define (e-task e) (car (cdr (cdr (cdr e)))))
(define (e-payload e) (car (cdr (cdr (cdr (cdr e))))))
;; push-newest: entries with seq > cursor and seq <= upto, oldest first.
(define (board-new cursor upto)
  (let loop ((b board) (acc (list)))
    (cond ((null? b) acc)
          ((<= (e-seq (car b)) cursor) acc)
          ((> (e-seq (car b)) upto) (loop (cdr b) acc))
          (else (loop (cdr b) (cons (car b) acc))))))
;; board_grep: entries of a type whose payload contains needle (newest first).
(define (board-grep type needle)
  (let loop ((b board) (acc (list)))
    (cond ((null? b) (reverse acc))
          ((and (string=? (e-type (car b)) type) (>= (string-index (e-payload (car b)) needle) 0))
           (loop (cdr b) (cons (car b) acc)))
          (else (loop (cdr b) acc)))))

;; ---------------------------------------------------------------- message interface
;; DMs: one buffered channel per worker. Broadcast: ANNOUNCE entries on the board.
(define inbox (make-hash))
(define (mk-inboxes! n) (let loop ((i 0)) (if (< i n) (begin (hash-set! inbox i (channel:create 4096)) (loop (+ i 1))) n)))
(define (dm! to from text rnd)
  (bump! "dm-sent" 1)
  (channel:send (hash-ref inbox to 0) (string-append (number->string from) " " (number->string rnd) " " text)))
(define (drain-inbox w)
  (let loop ((acc (list)))
    (let ((s (channel:try-recv (hash-ref inbox w 0))))
      (if (string=? s "") (reverse acc) (loop (cons (string-split s " ") acc))))))

;; ---------------------------------------------------------------- claims (live, atomic check-and-insert)
(define claims (make-hash))   ; task -> worker
(define done (make-hash))     ; task -> x | -1 (proven infeasible)
(define (try-claim! w i rnd)
  (bump! "claim-attempts" 1)
  (cond ((hash-has-key? done i) (bump! "claim-conflict-done" 1) #f)
        ((hash-has-key? claims i)
         (bump! "claim-conflicts" 1)
         (let ((owner (hash-ref claims i -1)))
           (if (not (= owner w)) (dm! owner w (string-append "WANT " (number->string i)) rnd))
           (= owner w)))
        (else (hash-set! claims i w) (board-post! "CLAIM" w i (number->string i) rnd) #t)))
(define (release! w i rnd) (hash-remove! claims i) (board-post! "RELEASE" w i (number->string i) rnd))

;; ---------------------------------------------------------------- shared workspace (git-like)
;; files = families; head version per file; commit log. Merge = fast-forward
;; if my base is head; else rebase (re-verify against head) and retry; a
;; duplicate result for a task is a conflict -> rollback (discard my patch).
(define ws-ver (make-hash))   ; family -> version
(define ws-log (list))
(define ws-head 0)
(define (ws-merge! w i x base rnd)
  (let ((g (fam i)))
    (cond ((hash-has-key? done i) (bump! "merge-rollback" 1) 'rollback)
          ((not (= base (hash-ref ws-ver g 0)))
           (bump! "merge-rebase" 1)
           (if (or (= x -1) (accept? i x)) (ws-merge! w i x (hash-ref ws-ver g 0) rnd) 'rollback))
          (else
           (hash-set! done i x)
           (hash-set! ws-ver g (+ 1 (hash-ref ws-ver g 0)))
           (set! ws-head (+ ws-head 1))
           (set! ws-log (cons (list ws-head w i x) ws-log))
           (hash-remove! claims i)
           (board-post! "PATCH_SUMMARY" w i (string-append "task " (number->string i) " x=" (number->string x) " verified") rnd)
           'merged))))

;; ---------------------------------------------------------------- worker local state
;; per worker: cursor, known roots per family (from FACT/FAIL), scan progress, my claim, base.
(define wstate (make-hash))
(define (ws-get w k d) (hash-ref (hash-ref wstate w 0) k d))  ; no (make-hash) default: flaky inside fibers (docs/swarm-design.md)
(define (ws-put! w k v) (hash-set! (hash-ref wstate w 0) k v))
(define (init-worker! w) (let ((h (make-hash))) (hash-set! wstate w h) (hash-set! h "cursor" 0) (hash-set! h "know" (make-hash)) (hash-set! h "scan" (make-hash)) (hash-set! h "mine" -1) (hash-set! h "turns" 0) (hash-set! h "partial" (make-hash)) (hash-set! h "view" (make-hash)) w))

;; ---------------------------------------------------------------- the one worker loop
;; Gather: read board entries newer than my cursor up to the round snapshot
;; (`upto`), my DMs. Claim: pick a subtask from my view, live claim. Act: mock
;; proposer (FACT lookup, else scan a window of W candidates). Verify:
;; acceptance check. Merge: shared workspace merge with rebase/rollback.
(define (gather! w upto rnd)
  (let ((t0 (monotonic-ms)) (know (ws-get w "know" 0)) (scan (ws-get w "scan" 0)) (view (ws-get w "view" 0)))
    (let loop ((es (board-new (ws-get w "cursor" 0) upto)) (n 0))
      (if (null? es) (bump! "gathered" n)
          (let ((e (car es)))
            (cond ((string=? (e-type e) "FACT") (hash-set! know (fam (e-task e)) (map string->number (string-split (e-payload e) ","))))
                  ((string=? (e-type e) "FAIL") (hash-set! know (fam (e-task e)) (list)))
                  ((string=? (e-type e) "CLAIM") (hash-set! view (e-task e) 1))
                  ((string=? (e-type e) "RELEASE") (hash-remove! view (e-task e)))
                  ((string=? (e-type e) "PATCH_SUMMARY") (hash-set! view (e-task e) 2))
                  ((string=? (e-type e) "OBSERVED") (let ((g (fam (e-task e))) (v (string->number (e-payload e)))) (if (> v (hash-ref scan g 0)) (hash-set! scan g v))))
                  (else #f))
            (loop (cdr es) (+ n 1)))))
    (ws-put! w "cursor" upto)
    ;; DMs: someone wants my claim; if I hold it but have not started, release (negotiation).
    (let loop ((ms (drain-inbox w)))
      (if (not (null? ms))
          (let* ((msg (car ms)) (sent-rnd (string->number (cadr msg))) (i (string->number (car (cdr (cdr (cdr msg)))))))
            (bump! "dm-recv" 1) (bump! "dm-latency-rounds" (- rnd sent-rnd))
            (if (and (= (ws-get w "mine" -1) i) (= 0 (hash-ref scan (fam i) 0)) (not (hash-has-key? know (fam i))))
                (begin (release! w i rnd) (ws-put! w "mine" -1) (bump! "negotiated-release" 1)))
            (loop (cdr ms)))))
    (tick-ms! "t-gather" t0)))

(define (pick w)
  ;; Uses only MY gathered view of the board (stale by design: peers act in the
  ;; same round), so live claims can conflict. Deterministic spread: start at a
  ;; worker-specific offset; prefer tasks whose family I already know (FACT/FAIL).
  (let ((know (ws-get w "know" 0)) (view (ws-get w "view" 0)) (start (modulo (* w 37) cfg-K)))
    (let loop ((k 0) (fallback -1))
      (if (= k cfg-K) fallback
          (let ((i (modulo (+ start k) cfg-K)))
            (if (hash-has-key? view i) (loop (+ k 1) fallback)
                (if (hash-has-key? know (fam i)) i (loop (+ k 1) (if (< fallback 0) i fallback)))))))))

(define (claim! w rnd)
  (let ((t0 (monotonic-ms)))
    (if (< (ws-get w "mine" -1) 0)
        (let ((i (pick w)))
          (if (>= i 0)
              (if (try-claim! w i rnd) (begin (ws-put! w "mine" i) (ws-put! w "base" (hash-ref ws-ver (fam i) 0)))))))
    ;; my claim may have been completed by someone else meanwhile
    (if (and (>= (ws-get w "mine" -1) 0) (hash-has-key? done (ws-get w "mine" -1))) (ws-put! w "mine" -1))
    (tick-ms! "t-claim" t0)))

;; Act: returns x, -1 (proven none), or #f (not finished; keep claim).
(define (scan-window g from)
  (let loop ((x from) (roots (list)))
    (if (or (>= x P) (>= x (+ from W))) (reverse roots) (loop (+ x 1) (if (feq x g) (cons x roots) roots)))))
(define (act! w rnd)
  (let ((t0 (monotonic-ms)) (i (ws-get w "mine" -1)) (res #f))
    (if (>= i 0)
        (let* ((g (fam i)) (know (ws-get w "know" 0)))
          (if (hash-has-key? know g)
              (let ((roots (hash-ref know g (list))))
                (bump! "fact-reuse" 1)
                (set! res (let f ((r roots)) (cond ((null? r) -1) ((accept? i (car r)) (car r)) (else (f (cdr r)))))))
              (let* ((scan (ws-get w "scan" 0)) (from (hash-ref scan g 0)) (roots (scan-window g from)) (to (min P (+ from W))))
                (bump! "evals" (- to from))
                (hash-set! scan g to)
                (let ((acc (append (hash-ref (ws-get w "partial" 0) g (list)) roots)))
                  (hash-set! (ws-get w "partial" 0) g acc)
                  (board-post! "OBSERVED" w i (number->string to) rnd)
                  (if (>= to P)
                      (begin
                        (hash-set! know g acc)
                        (if (null? acc) (board-post! "FAIL" w i "no-root" rnd)
                            (board-post! "FACT" w i (let j ((r (cdr acc)) (s (number->string (car acc)))) (if (null? r) s (j (cdr r) (string-append s "," (number->string (car r)))))) rnd))
                        (set! res (let f ((r acc)) (cond ((null? r) -1) ((accept? i (car r)) (car r)) (else (f (cdr r)))))))))))))
    (tick-ms! "t-act" t0)
    res))

(define (verify? w x)
  (let* ((t0 (monotonic-ms)) (i (ws-get w "mine" -1))
         (ok (cond ((not x) #f)
                   ((= x -1) (proven-none? i (hash-ref (ws-get w "know" 0) (fam i) (list))))
                   (else (accept? i x)))))
    (if (and x (not ok)) (begin (bump! "verify-fail" 1) (board-post! "FAIL" w i "verify" 0)))
    (tick-ms! "t-verify" t0)
    ok))

(define (merge! w x rnd)
  (let* ((t0 (monotonic-ms)) (i (ws-get w "mine" -1)) (r (ws-merge! w i x (ws-get w "base" 0) rnd)))
    (bump! (if (eq? r 'merged) "merged" "rolled-back") 1)
    (ws-put! w "mine" -1)
    (tick-ms! "t-merge" t0)
    r))

(define (worker-turn w upto rnd)
  (gather! w upto rnd)
  (claim! w rnd)
  (let ((x (act! w rnd)))
    (if (verify? w x) (merge! w x rnd)))
  (ws-put! w "turns" (+ 1 (ws-get w "turns" 0)))
  (bump! "turns-done" 1)
  w)

;; ---------------------------------------------------------------- runners
(define (reset! n k f)
  (set! cfg-N n) (set! cfg-K k) (set! cfg-F f)
  (set! board (list)) (set! nb 0) (set! claims (make-hash)) (set! done (make-hash))
  (set! ws-ver (make-hash)) (set! ws-log (list)) (set! ws-head 0) (set! wstate (make-hash))
  (set! m (make-hash)) (set! inbox (make-hash)) (mk-inboxes! n)
  (let loop ((w 0)) (if (< w n) (begin (init-worker! w) (loop (+ w 1))) n)))

;; epoch mode: every round, spawn N identical worker fibers (one turn each) and
;; join them. The ticker never looks at tasks; it only advances logical time
;; (Aura fibers here are run-to-completion: fiber:yield inside a body does not
;; interleave siblings, so a turn is the unit of interleaving).
(define (spawn-round n upto rnd)
  (let loop ((w 0) (fs (list)))
    (if (= w n) fs (loop (+ w 1) (cons (fiber:spawn (lambda () (worker-turn w upto rnd))) fs)))))
(define (join-all fs) (let loop ((f fs) (bad 0)) (if (null? f) bad (loop (cdr f) (if (number? (fiber:join (car f))) bad (+ bad 1))))))
(define (run-epochs n k f max-rounds)
  (reset! n k f)
  (let ((t0 (monotonic-ms)))
    (let loop ((rnd 1))
      (if (and (< (hash-length done) cfg-K) (<= rnd max-rounds))
          (let* ((ts (monotonic-ms)) (fs (spawn-round n nb rnd)) (tj (monotonic-ms)))
            (bump! "t-spawn" (- tj ts))
            (bump! "join-void" (join-all fs))
            (tick-ms! "t-join" tj)
            (loop (+ rnd 1)))
          (begin (hash-set! m "rounds" (- rnd 1)) (hash-set! m "wall-ms" (- (monotonic-ms) t0))
                 (hash-set! m "done" (hash-length done)) (hash-set! m "board" nb) (hash-set! m "commits" ws-head)
                 (summary))))))

;; free mode: one long-lived fiber per worker looping turns with fiber:yield
;; between turns (the Agensh shape). Exposes whether fibers interleave.
(define (worker-free w max-turns)
  (let loop ((t 0))
    (if (and (< (hash-length done) cfg-K) (< t max-turns))
        (begin (worker-turn w nb t) (fiber:yield) (loop (+ t 1)))
        t)))
(define (run-free n k f max-turns)
  (reset! n k f)
  (let* ((t0 (monotonic-ms))
         (fs (let loop ((w 0) (fs (list))) (if (= w n) fs (loop (+ w 1) (cons (fiber:spawn (lambda () (worker-free w max-turns))) fs)))))
         (t1 (monotonic-ms)))
    (bump! "t-spawn" (- t1 t0))
    (bump! "join-void" (join-all fs))
    (hash-set! m "wall-ms" (- (monotonic-ms) t0)) (hash-set! m "done" (hash-length done)) (hash-set! m "board" nb) (hash-set! m "commits" ws-head)
    (hash-set! m "max-worker-share" (max-share n))
    (summary)))
(define (max-share n) (let loop ((w 0) (best 0)) (if (= w n) best (loop (+ w 1) (max best (count-merged-by w))))))
(define (count-merged-by w) (let loop ((l ws-log) (c 0)) (if (null? l) c (loop (cdr l) (if (= (cadr (car l)) w) (+ c 1) c)))))

(define (all-accepted?) (let loop ((i 0)) (cond ((= i cfg-K) #t) ((not (hash-has-key? done i)) #f)
  ((let ((x (hash-ref done i -2))) (if (= x -1) (proven-none? i (scan-all (fam i))) (accept? i x))) (loop (+ i 1))) (else #f))))
(define (scan-all g) (let loop ((x 0) (r (list))) (if (= x P) r (loop (+ x 1) (if (feq x g) (cons x r) r)))))
(define (summary)
  (hash-set! m "accepted" (if (all-accepted?) 1 0))
  (let loop ((ks (hash-keys m)) (s ""))
    (if (null? ks) s (loop (cdr ks) (string-append s (car ks) "=" (number->string (hash-ref m (car ks) 0)) ";")))))

;; ---------------------------------------------------------------- micro benches
(define (bench-board n)
  (set! board (list)) (set! nb 0)
  (let* ((t0 (monotonic-ms))
         (_ (let loop ((i 0)) (if (< i n) (begin (board-post! (if (= 0 (modulo i 10)) "FACT" "OBSERVED") (modulo i 64) i (number->string i) 0) (loop (+ i 1))))))
         (t1 (monotonic-ms))
         (hits (length (board-grep "FACT" "7")))
         (t2 (monotonic-ms))
         (newn (length (board-new (- n 100) n)))
         (t3 (monotonic-ms)))
    (string-append "appends=" (number->string n) ";append-ms=" (number->string (- t1 t0)) ";grep-ms=" (number->string (- t2 t1)) ";grep-hits=" (number->string hits) ";new100-ms=" (number->string (- t3 t2)) ";")))
(define (bench-chan n)
  (let* ((c (channel:create (+ n 1))) (t0 (monotonic-ms))
         (_ (let loop ((i 0)) (if (< i n) (begin (channel:send c "7 1 WANT 3") (loop (+ i 1))))))
         (t1 (monotonic-ms))
         (_r (let loop ((i 0)) (if (< i n) (begin (channel:try-recv c) (loop (+ i 1))))))
         (t2 (monotonic-ms)))
    (string-append "msgs=" (number->string n) ";send-ms=" (number->string (- t1 t0)) ";recv-ms=" (number->string (- t2 t1)) ";")))
(define (bench-spawn n)
  (let* ((t0 (monotonic-ms)) (fs (let loop ((i 0) (fs (list))) (if (= i n) fs (loop (+ i 1) (cons (fiber:spawn (lambda () i)) fs)))))
         (t1 (monotonic-ms)) (bad (join-all fs)) (t2 (monotonic-ms)))
    (string-append "n=" (number->string n) ";spawn-ms=" (number->string (- t1 t0)) ";join-ms=" (number->string (- t2 t1)) ";join-void=" (number->string bad) ";")))
