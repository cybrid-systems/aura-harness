;; aura/supervisor.aura — orchestrated (supervisor) mode for the same toy task as aura/swarm.aura.
;; Load AFTER swarm.aura: reuses the task (fam/feq/accept?), metrics, workspace merge (ws-merge!),
;; inboxes, liveness clock (beat!/lease-expired?), reset!, join-all and done-valid?.
;;
;; One supervisor fiber owns all planning: it splits every family's [0,P) scan into windows of W,
;; dispatches each window exactly once to a live worker (at most SV-Q outstanding per worker) over the
;; worker's inbox channel, collects results on one result channel (ask/reply round trip), and when a
;; family's windows are all back it verifies and merges every subtask of that family itself.
;; Workers hold no shared state: receive job -> scan window -> reply. A worker whose heartbeat lease
;; expires with outstanding jobs is marked dead and its jobs are re-dispatched.
(define SV-Q 2)
(define sv-res #f)          ; result channel (worker -> supervisor)
(define sv-fin #f)          ; supervisor finished
(define sv-out (make-hash)) ; "g:from" -> (w t-sent)
(define sv-win (make-hash)) ; g -> hash from -> roots
(define sv-load (make-hash)); w -> outstanding jobs
(define sv-dead (make-hash)); w -> 1
(define sv-queue (list))    ; pending (g from)
(define sv-ffirst (make-hash)) ; g -> first dispatch ms
(define sv-fw (make-hash))     ; g -> hash of workers that returned a window (trace only)
;; trace: a family's scan cost is shared by its siblings (K/F subtasks); a supervisor-mode row's worker field is
;; the number of distinct workers that scanned the family, evals = the family's scan / siblings
(define (sv-fam-evals g) (quotient P (max 1 (quotient (+ cfg-K (- cfg-F 1)) cfg-F))))
(define (sv-key g from) (string-append (number->string g) ":" (number->string from)))
(define (sv-reset! n k f)
  (reset! n k f)
  (set! sv-res (channel:create 65536)) (set! sv-fin #f) (set! sv-out (make-hash)) (set! sv-win (make-hash))
  (set! sv-load (make-hash)) (set! sv-dead (make-hash)) (set! sv-ffirst (make-hash)) (set! sv-fw (make-hash))
  (set! sv-queue (let gl ((g (- f 1)) (acc (list)))
                   (if (< g 0) acc
                       (gl (- g 1) (let wl ((x (* W (quotient (- P 1) W))) (a acc)) (if (< x 0) a (wl (- x W) (cons (list g x) a))))))))
  (let loop ((g 0)) (if (< g f) (begin (hash-set! sv-win g (make-hash)) (loop (+ g 1))) f)))

;; ------------------------------------------------------------ worker: no shared state
(define (sv-worker w)
  (let loop ((jobs 0))
    (beat! w)
    (if (or sv-fin stop) jobs
        (let ((s (channel:try-recv (hash-ref inbox w 0))))
          (cond ((string=? s "") (fiber:yield) (loop jobs))
                ((and (= w kill-w) (>= jobs kill-at)) (bump! "killed" 1) (set! kill-w -1) (error "supervisor: injected worker failure"))
                (else
                 (let* ((p (string-split s " ")) (tag (car p)))
                   (if (string=? tag "P")
                       (channel:send sv-res (string-append "P " (number->string w) " " (cadr p)))
                       (let* ((g (string->number (cadr p))) (from (string->number (caddr p))) (to (min P (+ from W))))
                         (bump! "evals" (- to from))
                         (channel:send sv-res (string-append "R " (number->string w) " " (number->string g) " " (number->string from) " " (roots->str (scan-window g from))))))
                   (bump! "turns-done" 1)
                   (fiber:yield)
                   (loop (+ jobs 1)))))))))

;; ------------------------------------------------------------ supervisor
(define (sv-live n) (let loop ((w 0) (acc (list))) (if (= w n) (reverse acc) (loop (+ w 1) (if (hash-has-key? sv-dead w) acc (cons w acc))))))
(define (sv-dispatch! n)
  (let loop ((ws (sv-live n)))
    (if (and (not (null? ws)) (not (null? sv-queue)))
        (let ((w (car ws)))
          (if (< (hash-ref sv-load w 0) SV-Q)
              (let* ((j (car sv-queue)) (g (car j)) (from (cadr j)))
                (set! sv-queue (cdr sv-queue))
                (hash-set! sv-out (sv-key g from) (list w (monotonic-ms)))
                (hash-set! sv-load w (+ 1 (hash-ref sv-load w 0)))
                (if (not (hash-has-key? sv-ffirst g)) (hash-set! sv-ffirst g (monotonic-ms)))
                (bump! "jobs-sent" 1)
                (channel:send (hash-ref inbox w 0) (string-append "J " (number->string g) " " (number->string from)))
                (loop ws))
              (loop (cdr ws)))))))
(define (sv-family-done! g)
  (let ((roots (let ((h (hash-ref sv-win g 0))) (let loop ((x 0) (acc (list))) (if (>= x P) acc (loop (+ x W) (append acc (hash-ref h x (list)))))))))
    (let loop ((i g))
      (if (< i cfg-K)
          (let ((x (let f ((r roots)) (cond ((null? r) -1) ((accept? i (car r)) (car r)) (else (f (cdr r)))))))
            (if (if (= x -1) (proven-none? i roots) (accept? i x))
                (if (eq? (ws-merge! -1 i x (hash-ref ws-ver g 0) 0) 'merged)
                    (let ((lat (- (monotonic-ms) (hash-ref sv-ffirst g 0))))
                      (trace-row! i (if (hash-has-key? sv-fw g) (hash-length (hash-ref sv-fw g 0)) 0) (hash-ref sv-ffirst g 0) (sv-fam-evals g) 0 "merged")
                      (bump! "merged" 1) (bump! "lat-ms" lat) (if (> lat (hash-ref m "lat-max-ms" 0)) (hash-set! m "lat-max-ms" lat)))
                    (begin (trace-row! i -1 (hash-ref sv-ffirst g 0) 0 0 "rollback") (bump! "rolled-back" 1)))
                (bump! "verify-fail" 1))
            (loop (+ i cfg-F)))))))
(define (sv-collect!)
  (let loop ()
    (let ((s (channel:try-recv sv-res)))
      (if (not (string=? s ""))
          (let* ((p (string-split s " ")) (w (string->number (cadr p))))
            (if (string=? (car p) "R")
                (let* ((g (string->number (caddr p))) (from (string->number (car (cdr (cdr (cdr p))))))
                       (rs (if (null? (cdr (cdr (cdr (cdr p))))) (list) (str->roots (car (cdr (cdr (cdr (cdr p))))))))
                       (k (sv-key g from)) (h (hash-ref sv-win g 0)))
                  (hash-set! sv-load w (max 0 (- (hash-ref sv-load w 0) 1)))
                  (if trace-on (begin (if (not (hash-has-key? sv-fw g)) (hash-set! sv-fw g (make-hash))) (hash-set! (hash-ref sv-fw g 0) w 1)))
                  (if (hash-has-key? h from)
                      (bump! "dup-results" 1)
                      (begin
                        (if (hash-has-key? sv-out k)
                            (let ((rtt (- (monotonic-ms) (cadr (hash-ref sv-out k 0)))))
                              (bump! "rtt-n" 1) (bump! "rtt-ms" rtt) (if (> rtt (hash-ref m "rtt-max-ms" 0)) (hash-set! m "rtt-max-ms" rtt))))
                        (hash-remove! sv-out k)
                        (hash-set! h from rs)
                        (if (= (length (hash-keys h)) (quotient (+ P (- W 1)) W)) (sv-family-done! g)))))
                (bump! "pings-recv" 1))
            (loop))))))
;; outstanding job whose worker stopped heart-beating -> mark dead, re-queue its jobs
(define (sv-reap!)
  (let loop ((ks (hash-keys sv-out)))
    (if (not (null? ks))
        (let* ((k (car ks)) (o (hash-ref sv-out k 0)) (w (car o)))
          (if (and (not (hash-has-key? sv-dead w)) (lease-expired? w))
              (begin (hash-set! sv-dead w 1) (bump! "workers-dead" 1)))
          (if (hash-has-key? sv-dead w)
              (let ((ps (string-split k ":")))
                (hash-remove! sv-out k) (bump! "jobs-redispatched" 1)
                (set! sv-queue (cons (list (string->number (car ps)) (string->number (cadr ps))) sv-queue))))
          (loop (cdr ks))))))
(define (sv-supervisor n max-iters)
  (let loop ((it 0))
    (if (and (< (hash-length done) cfg-K) (< it max-iters) (not stop) (not (null? (sv-live n))))
        (begin (beat! -1) (sv-collect!) (sv-reap!) (sv-dispatch! n) (fiber:yield) (loop (+ it 1)))
        (begin (hash-set! m "sv-iters" it) (set! sv-fin #t)
               (if stop (let ((x (monotonic-ms))) (if (> x (hash-ref m "t-last-exit" 0)) (hash-set! m "t-last-exit" x))))
               it))))
(define (sv-spawn n max-iters)
  (cons (fiber:spawn (lambda () (sv-supervisor n max-iters)))
        (let loop ((w 0) (fs (list))) (if (= w n) fs (loop (+ w 1) (cons (fiber:spawn (lambda () (sv-worker w))) fs))))))
(define (sv-finish! n t0)
  (hash-set! m "lost" (- cfg-K (hash-length done)))
  (finish-free! n t0))
(define (run-supervisor n k f max-iters)
  (sv-reset! n k f)
  (let* ((t0 (monotonic-ms)) (fs (sv-spawn n max-iters)))
    (bump! "join-void" (join-all fs))
    (sv-finish! n t0)))
(define (run-sv-fail n k f max-iters at)
  (sv-reset! n k f) (set! kill-w 0) (set! kill-at at)
  (let* ((t0 (monotonic-ms)) (fs (sv-spawn n max-iters)))
    (bump! "join-void" (join-all fs))
    (set! kill-w -1)
    (sv-finish! n t0)))
(define (run-sv-cancel n k f max-iters after)
  (sv-reset! n k f)
  (let* ((t0 (monotonic-ms)) (fs (sv-spawn n max-iters))
         (ctl (fiber:spawn (lambda () (let loop () (if (< (- (monotonic-ms) t0) after) (begin (fiber:yield) (loop))
                                                       (begin (hash-set! m "t-stop" (monotonic-ms)) (set! stop #t) 0)))))))
    (bump! "join-void" (join-all (cons ctl fs)))
    (hash-set! m "cancel-lat-ms" (if (> (hash-ref m "t-stop" 0) 0) (- (hash-ref m "t-last-exit" (hash-ref m "t-stop" 0)) (hash-ref m "t-stop" 0)) -1))
    (hash-set! m "stopped-early" (if (< (hash-length done) cfg-K) 1 0))
    (set! stop #f)
    (sv-finish! n t0)))

;; ------------------------------------------------------------ ask/reply round trip
;; channel ask/reply: supervisor fiber pings each of N worker fibers `reps` times, waits for each reply.
(define (run-sv-ping n reps)
  (sv-reset! n 1 1) (set! sv-queue (list))
  (let* ((tw (monotonic-ms))
         (ws (let loop ((w 0) (fs (list))) (if (= w n) fs (loop (+ w 1) (cons (fiber:spawn (lambda () (sv-worker w))) fs)))))
         (cli (fiber:spawn (lambda ()
                (let loop ((r 0))
                  (if (< r (* n reps))
                      (let ((t0 (monotonic-ms)) (w (modulo r n)))
                        (channel:send (hash-ref inbox w 0) (string-append "P " (number->string r)))
                        (let wait ((spins 0))
                          (let ((s (channel:try-recv sv-res)))
                            (if (string=? s "")
                                (if (< spins 1000000) (begin (fiber:yield) (wait (+ spins 1))) (bump! "ping-timeout" 1))
                                (let ((dt (- (monotonic-ms) t0)))
                                  (bump! "ping-n" 1) (bump! "ping-ms" dt) (if (> dt (hash-ref m "ping-max-ms" 0)) (hash-set! m "ping-max-ms" dt))))))
                        (loop (+ r 1)))
                      (begin (hash-set! m "ping-wall-ms" (- (monotonic-ms) tw)) (set! sv-fin #t))))))))
    (bump! "join-void" (join-all (cons cli ws)))
    (kv-dump)))
;; orch:agent-ask round trip to an in-process responder (see aura#4722): status + elapsed
(define (orch-ask-probe timeout-ms)
  (set! m (make-hash))
  (try
   (begin
     (orch:spawn-agent "sv-svc" (lambda () 0) :attach-mailbox #t)
     (let* ((t0 (monotonic-ms))
            (srv (fiber:spawn (lambda () (let loop ((k 0)) (let ((r (orch:agent-recv "sv-svc" :wait #f)))
                                (if (hash-ref r "ok") (let ((p (hash-ref r "payload")))
                                                        (hash-set! m "ask-reply-status" (str-of (let ((x (orch:agent-reply (let c ((i 4)) (if (char=? (string-ref p i) #\:) (string->number (substring p 4 i)) (c (+ i 1)))) "pong"))) (hash-ref x "status")))))
                                    (if (< k 200000) (begin (fiber:yield) (loop (+ k 1))) 0)))))))
            (a (orch:agent-ask "sv-svc" "ping" :timeout-ms timeout-ms)))
       (hash-set! m "ask-ms" (- (monotonic-ms) t0))
       (hash-set! m "ask-status" (str-of (hash-ref a "status")))
       (fiber:join srv) (kv-dump)))
   (catch (e) (hash-set! m "ask-status" "error") (kv-dump))))

;; ------------------------------------------------------------ orch:* primitives at N
;; supervise-batch failure recovery: N tasks, task 0 raises; compare default :watch-scope vs #f (aura#4723).
;; scope-cancel-all: N scope bodies looping on fiber:yield; does cancel stop them (aura#4724)?
(define sb-ran (make-hash))
(define (sb-tasks n) (let loop ((i (- n 1)) (acc (list))) (if (< i 0) acc (loop (- i 1) (cons (if (= i 0) (lambda () (error "sv: injected task failure")) (let ((j i)) (lambda () (hash-set! sb-ran j 1) j))) acc)))))
(define cx-stop #f)
(define cx-steps 0)
(define (cx-body) (let loop ((k 0)) (if (or cx-stop (> k 2000000)) k (begin (set! cx-steps (+ cx-steps 1)) (fiber:yield) (loop (+ k 1))))))
(define (str-of v) (cond ((string? v) v) ((number? v) (number->string v)) ((symbol? v) (symbol->string v)) ((eq? v #t) "t") ((eq? v #f) "f") (else "?")))
(define (orch-probes n)
  (set! m (make-hash))
  (let ((pol (orch:compose-workflow 'collect-all :max-retries 1)))
    (set! sb-ran (make-hash))
    (let* ((t0 (monotonic-ms)) (r (orch:supervise-batch (sb-tasks n) pol :watch-scope #t)))
      (hash-set! m "sbw-ms" (- (monotonic-ms) t0)) (hash-set! m "sbw-status" (str-of (hash-ref r "status")))
      (hash-set! m "sbw-ok" (try (hash-ref r "ok-count") (catch (e) -1))) (hash-set! m "sbw-err" (try (hash-ref r "err-count") (catch (e) -1)))
      (hash-set! m "sbw-ran" (hash-length sb-ran)))
    (set! sb-ran (make-hash))
    (let* ((t0 (monotonic-ms)) (r (orch:supervise-batch (sb-tasks n) pol :watch-scope #f)))
      (hash-set! m "sbn-ms" (- (monotonic-ms) t0)) (hash-set! m "sbn-status" (str-of (hash-ref r "status")))
      (hash-set! m "sbn-ok" (try (hash-ref r "ok-count") (catch (e) -1))) (hash-set! m "sbn-err" (try (hash-ref r "err-count") (catch (e) -1)))
      (hash-set! m "sbn-ran" (hash-length sb-ran))))
  (set! cx-stop #f) (set! cx-steps 0)
  (let loop ((i 0)) (if (< i n) (begin (orch:scope-spawn (string-append "cx-" (number->string i)) cx-body) (loop (+ i 1)))))
  (let wait ((k 0)) (if (< k 200) (begin (fiber:yield) (wait (+ k 1)))))
  (let* ((t0 (monotonic-ms)) (c (orch:scope-cancel-all)) (t1 (monotonic-ms)) (s0 cx-steps))
    (hash-set! m "cx-cancelled" (try (hash-ref c "cancelled-count") (catch (e) -1))) (hash-set! m "cx-cancel-ms" (- t1 t0))
    (let wait ((k 0)) (if (< k 2000) (begin (fiber:yield) (wait (+ k 1)))))
    (hash-set! m "cx-steps-after-cancel" (- cx-steps s0))
    (let* ((t2 (monotonic-ms)) (j (orch:scope-join-all :timeout-ms 1000)))
      (hash-set! m "cx-join-status" (str-of (hash-ref j "status"))) (hash-set! m "cx-join-ms" (- (monotonic-ms) t2)))
    (set! cx-stop #t)
    (let* ((t3 (monotonic-ms)) (j (orch:scope-join-all :timeout-ms 5000)))
      (hash-set! m "cx-join2-status" (str-of (hash-ref j "status"))) (hash-set! m "cx-join2-ms" (- (monotonic-ms) t3))))
  (kv-dump))
(define (kv-dump)
  (let loop ((ks (hash-keys m)) (s ""))
    (if (null? ks) s (loop (cdr ks) (string-append s (car ks) "=" (str-of (hash-ref m (car ks) 0)) ";")))))
