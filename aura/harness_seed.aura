;; aura-harness seed harness (version 0), loaded with set-code + eval-current.
;; Every harness component is a separate workspace define. The first five are the MUTABLE policy layer the proposer
;; may rewrite (mutate:rebind, guarded by server.aura); the last four are the PROTECTED runtime boundary that no
;; proposal may touch. The guard lives in server.aura, outside the workspace, so it cannot be rebound itself.
;; Flat conds, compiled from tables by the proposer. (This was a workaround for cybrid-systems/aura#4583 / #4584,
;; both fixed upstream.)

;; ---- mutable: tool routing. which tool serves a capability the task needs
(define route-tool
  (lambda (need)
    (cond ((equal? need "search") "grep")
          ((equal? need "read") "cat")
          ((equal? need "edit") "sed")
          ((equal? need "test") "pytest")
          ((equal? need "query-db") "sql")
          ((equal? need "logs") "journal")
          (else "cat"))))

;; ---- mutable: context compression / output truncation per tool-output kind -> (strategy limit-tokens)
;;   strategies: none | head | tail | head-tail | grep-errors | summarize
(define compress
  (lambda (kind)
    (cond (else (list "head" 800)))))

;; ---- mutable: retry / error policy. extra attempts after a tool error of this kind
(define retry-limit
  (lambda (tool err)
    (cond (else 1))))

;; ---- mutable: memory promotion. carry a learned project fact to later tasks for this many tasks (0 = never)
(define memory-ttl
  (lambda (fact)
    (cond (else 0))))

;; ---- mutable: sub-agent orchestration. run each subtask in a fresh sub-agent context, or inline
(define delegate
  (lambda (kind nsub)
    (cond (else "inline"))))

;; ---- mutable (M6, HarnessPro mapping): task-tier router. task kind x subtask count -> tier
;;   tiers: compact | lean | standard | deep (reasoning effort + per-step token profile; see devenv.TIER_PROFILE)
(define task-tier
  (lambda (kind nsub)
    (cond (else "standard"))))

;; ---- mutable (M6): staged tool-budget hook. tier -> (economy strict finalize) tool-call thresholds; (0 0 0) = off.
;;   Nudges are appended to the tail of a tool result (prompt-prefix cache stays valid); past finalize the call is refused.
(define tool-budget
  (lambda (tier)
    (cond (else (list 0 0 0)))))

;; ---- PROTECTED runtime boundary (never in the mutation allowlist)
(define context-budget (lambda () 4000))
(define max-steps (lambda () 30))
(define allowed-tools
  (lambda () (list "grep" "rg-json" "lsp-find" "cat" "sed" "apply-patch" "pytest" "pytest-q" "sql" "journal")))
(define sandbox-level (lambda () "restricted"))
