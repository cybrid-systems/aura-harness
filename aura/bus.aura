;; bus.aura — aura-harness on the Aura bus (aura-harness#4, aura#5128).
;;
;; Loaded at runtime by server.aura ONLY when AURA_HARNESS_BUS_WORKSPACE=N
;; (the pin a6c63aa19 has no std/bus; a static require would break it).
;; The harness peer attaches to the TARGET workspace's bus — the host is
;; the workspace owner (aura-perf's parent, or a coordinator script), not
;; this process. Role 2 (harness), caps read|publish = 3: the harness
;; subscribes to trials/metrics/worldlines and publishes regression and
;; release verdicts; it does not open trials. KEEP/ROLLBACK needs the
;; host's scoped grant, activated via hbus:accept-grant (aura#5377/#5382):
;; the session keeps its read/publish bits and gains keep+rollback scoped
;; to one worldline. Without an active grant scoped to it, a judge
;; keep/rollback is refused permission — there is no local path around
;; the grant.
;;
;; Read semantics (PROV parity): a failed read is an error record with a
;; code, "no metrics" is an ok record with count 0. They are never merged.
;;
;; Channel mapping (shared with aura-perf's docs/bus.md):
;;   metrics    perf hypothesis key K -> base-ms; summary 900001/900002.
;;              harness verdicts: 910000 + wl -> 1 release / 0 reject;
;;              regression evidence: 920000 + wl -> held-out ok count,
;;              930000 + wl -> held-out task count.
;;   worldlines one record per trial (id, parent, state, constraint,
;;              patch range); state 0 pending / 1 kept / 2 rolled /
;;              3 rejected / 4 canary (observation window, aura#5381).
;;   audit      the coordinator's log; every tool reads the same one.

(require "std/bus" all:)

(define *bus-sid* #f)
(define *bus-ws* 0)
(define *bus-lines* (list))

(define (bus-say! line) (set! *bus-lines* (cons line *bus-lines*)))

;; Attach + subscribe metrics(1), cct(2), patches(3), worldlines(4).
;; -> (ok session workspace) | (error code message); never raises.
(define (hbus:start ws)
  (let ((s (bus:attach "" ws 2 3 255)))
    (if (not (bus:ok? s))
        (begin (bus-say! (string-append "bus attach-failed " (bus:code s) ": " (bus:message s))) s)
        (begin
          (set! *bus-sid* (car (cdr s)))
          (set! *bus-ws* ws)
          (bus:subscribe *bus-sid* 1)
          (bus:subscribe *bus-sid* 2)
          (bus:subscribe *bus-sid* 3)
          (bus:subscribe *bus-sid* 4)
          (bus-say! (string-append "bus attached ws=" (number->string ws)
                                   " role=harness session=" (number->string *bus-sid*)))
          s))))

(define (hbus:attached?) (if *bus-sid* #t #f))

;; One channel read, cursor-aware. -> (ok generation count snapshot rows)
;; or the error record unchanged. Rows: metrics (key value), cct (parent
;; mid node samples self-ns), patches (node field value worldline gen),
;; worldlines (id parent state constraint patch-off patch-len).
(define (hbus:read channel since-gen since-count)
  (if (not *bus-sid*)
      (list "error" "no-bus" "not attached")
      (bus:query *bus-sid* channel since-gen since-count)))

;; The metrics face with PROV parity: three distinguishable outcomes.
;;   (ok rows)            rows = ((key value) ...), possibly empty
;;   (none)               ok read, zero records — "no metrics"
;;   (error code message) the read itself failed — never mapped to none
(define (hbus:rows r)
  (let ((xs (list-ref r 4))) (if (list? xs) xs (list))))

(define (hbus:metrics since-gen since-count)
  (let ((r (hbus:read 1 since-gen since-count)))
    (cond ((bus:error? r) r)
          ((= (list-ref r 2) 0) (list "none"))
          (else (list "ok" (hbus:rows r))))))

;; The worldline table (state of every trial the coordinator knows):
;; 0 pending / 1 kept / 2 rolled / 3 rejected / 4 canary (aura#5381).
(define (hbus:state-name s)
  (cond ((= s 0) "pending") ((= s 1) "kept") ((= s 2) "rolled")
        ((= s 3) "rejected") ((= s 4) "canary")
        (else (string-append "state-" (number->string s)))))

(define (hbus:worldlines)
  (let ((r (hbus:read 4 0 0)))
    (if (bus:error? r) r (list "ok" (hbus:rows r)))))

;; The last record the ledger appended for one worldline id (the channel
;; is append-only: a settled trial appears again with its final state).
(define (hbus:wl-record wl)
  (let ((r (hbus:worldlines)))
    (if (bus:error? r) r
        (let loop ((rows (cadr r)) (found #f))
          (if (null? rows)
              (if found (list "ok" found) (list "error" "unregistered-id" "worldline has no committed record"))
              (loop (cdr rows) (if (= (car (car rows)) wl) (car rows) found)))))))

;; ── scoped-grant judge (aura#5377/#5382) ─────────────────────────
;; The host derives a keep+rollback token scoped to one worldline and
;; hands it over out-of-band (control-plane BUSGRANT). Activation keeps
;; this session's read/publish bits and gains the delegated keep+rollback
;; on the token's worldline only. -> (ok bits worldline) | error record.
(define *bus-grant-wl* #f)

(define (hbus:accept-grant token)
  (if (not *bus-sid*)
      (list "error" "no-bus" "not attached")
      (let ((r (bus:grant-activate *bus-sid* token)))
        (if (bus:ok? r)
            (begin
              (set! *bus-grant-wl* (car (cdr (cdr r))))
              (bus-say! (string-append "bus grant-activated wl=" (number->string *bus-grant-wl*)
                                       " bits=" (number->string (car (cdr r)))))
              r)
            (begin (bus-say! (string-append "bus grant-failed " (bus:code r) ": " (bus:message r))) r)))))

;; Judge one worldline: read its ledger record (channel 4), its evidence
;; five-tuple (bus:evidence) and its committed patch records (channel 3),
;; run the hidden-set replay (the host's existing regression logic —
;; server.aura's bench; its pass/fail arrives as pass?), then KEEP on pass
;; or ROLLBACK on fail. Never keeps without an active grant scoped to wl:
;; the check is local AND the coordinator re-checks the capability.
;; The evidence tail is projected with the verdict record: a pending
;; trial's record carries zeros until KEEP/ROLLBACK re-projects it, so
;; the reported five-tuple is read AFTER the verdict (the coordinator
;; enforced the bound tuple at KEEP either way).
;; -> verdict hash with the worldline's final state.
(define (hbus:judge wl pass?)
  (if (not *bus-sid*)
      (hash "ok" #f "verdict" "none" "reason" "no-bus")
      (if (not (and (number? *bus-grant-wl*) (= *bus-grant-wl* wl)))
          (hash "ok" #f "verdict" "none" "reason" "no-grant" "worldline" wl)
          (let ((wr0 (hbus:wl-record wl))
                (pr (hbus:read 3 0 0)))
            (if (bus:error? wr0)
                (hash "ok" #f "verdict" "none" "reason" (bus:code wr0) "worldline" wl)
                (let* ((patches (if (bus:ok? pr)
                                    (filter (lambda (row) (= (list-ref row 3) wl)) (hbus:rows pr))
                                    (list)))
                       (r (if pass? (bus:keep *bus-sid* wl 0 0) (bus:rollback *bus-sid* wl)))
                       (ev (bus:evidence *bus-sid* wl))
                       (wr (hbus:wl-record wl))
                       (state (if (bus:ok? wr) (list-ref (cadr wr) 2) -1)))
                  (bus-say! (string-append "bus-judge wl=" (number->string wl)
                                           " " (if pass? "pass" "fail")
                                           " -> " (if (bus:ok? r) (hbus:state-name state) (bus:code r))))
                  (hash "ok" (bus:ok? r)
                        "verdict" (if (bus:ok? r) (if pass? "KEEP" "ROLLBACK") "none")
                        "worldline" wl "state" state "state_name" (hbus:state-name state)
                        "evidence" (if (bus:ok? ev) (cdr ev) (list))
                        "patches" patches
                        "reason" (if (bus:ok? r) "" (bus:code r)))))))))

;; The shared audit. worldline 0 = all events.
(define (hbus:audit worldline)
  (if (not *bus-sid*)
      (list "error" "no-bus" "not attached")
      (bus:audit *bus-sid* worldline)))

;; Publish the regression/release verdict for one worldline. release? is
;; the gate's decision (held-out regression passed); ok-count/n are the
;; held-out evidence. The coordinator's constraint gate is NOT bypassed:
;; this is evidence + verdict, KEEP itself stays with the trial's owner.
;; -> (ok generation count) | error record.
(define (hbus:verdict wl release? ok-count n)
  (if (not *bus-sid*)
      (list "error" "no-bus" "not attached")
      (let ((r (bus:publish *bus-sid* (+ 910000 wl) (if release? 1 0))))
        (if (bus:ok? r)
            (begin
              (bus:publish *bus-sid* (+ 920000 wl) ok-count)
              (bus:publish *bus-sid* (+ 930000 wl) n)
              (bus-say! (string-append "bus-verdict wl=" (number->string wl)
                                       " " (if release? "release" "reject")
                                       " heldout=" (number->string ok-count) "/" (number->string n)))
              r)
            (begin (bus-say! (string-append "bus verdict-failed " (bus:code r) ": " (bus:message r))) r)))))

;; Detach: the coordinator rolls back this session's pending trials (none
;; for a read|publish peer; a judge's un-kept grant worldline belongs to
;; the proposer) and reclaims its loans; the host keeps serving and the
;; committed evidence stays for the next tool.
(define (hbus:finish)
  (if (not *bus-sid*)
      (list "ok" 0)
      (let ((a (bus:audit *bus-sid* 0))
            (n (length *bus-lines*)))
        (bus:detach *bus-sid*)
        (set! *bus-sid* #f)
        (bus-say! "bus detached (host stays for perf/maintainer)")
        (list "ok" (if (bus:ok? a) (car (cdr a)) -1) n))))

(define (hbus:lines) (reverse *bus-lines*))
